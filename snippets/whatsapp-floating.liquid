{% comment %}
  Floating WhatsApp button — premium minimal treatment matching ATTARWALAS
  palette (cream #fcfaf5, gold #b88a2a).

  Hidden while the cart drawer is open and on the cart page.
  Rendered from layout/theme.liquid; configured via Theme settings > Social media.

  Usage:
  {% render 'whatsapp-floating' %}
{% endcomment %}

{%- if settings.whatsapp_number != blank -%}
  <a
    href="https://wa.me/{{ settings.whatsapp_number | remove: ' ' | remove: '-' }}"
    class="whatsapp-float"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Chat with us on WhatsApp"
  >
    <span class="whatsapp-float__icon" aria-hidden="true">
      <svg viewBox="0 0 448 512" xmlns="http://www.w3.org/2000/svg">
        <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/>
      </svg>
    </span>
    <span class="whatsapp-float__label">Chat with us</span>
  </a>

  <style>
    .whatsapp-float {
      /* Stacked above the Shopify Inbox chat bubble (~20px + 46px tall,
         z-index 2147483000 — Inbox always wins the stacking order, so this
         button is positioned above it instead of trying to out-stack it).
         --aw-float-lift is published by snippets/floating-stack.liquid and
         raises both launchers clear of any bottom-pinned bar (sticky
         add-to-cart, offer bar) that would otherwise be covered. */
      position: fixed;
      right: 24px;
      bottom: calc(92px + var(--aw-float-lift, 0px));
      z-index: 990;
      display: inline-flex;
      align-items: center;
      flex-direction: row-reverse;
      height: 64px;
      max-width: 64px;
      padding: 0;
      border-radius: 999px;
      background: #fcfaf5;
      color: #b88a2a;
      text-decoration: none;
      white-space: nowrap;
      overflow: hidden;
      border: 2px solid #b88a2a;
      box-shadow: 0 8px 24px rgba(43, 36, 24, 0.18);
      animation: whatsapp-float-in 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.4s both;
      transition:
        max-width 0.35s cubic-bezier(0.4, 0, 0.2, 1),
        transform 0.35s cubic-bezier(0.4, 0, 0.2, 1),
        bottom 0.2s ease,
        box-shadow 0.35s ease,
        opacity 0.25s ease;
    }

    .whatsapp-float__icon {
      flex: 0 0 64px;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .whatsapp-float__icon svg {
      width: 30px;
      height: 30px;
      fill: currentColor;
      display: block;
    }

    .whatsapp-float__label {
      font-family: var(--font-body-family);
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #9a7420;
      padding: 0 6px 0 10px;
      opacity: 0;
      transform: translateX(8px);
      transition: opacity 0.3s ease 0.05s, transform 0.3s ease 0.05s;
    }

    .whatsapp-float:hover,
    .whatsapp-float:focus-visible {
      max-width: 230px;
      transform: translateY(-2px);
      box-shadow: 0 12px 28px rgba(43, 36, 24, 0.24);
    }

    .whatsapp-float:hover .whatsapp-float__label,
    .whatsapp-float:focus-visible .whatsapp-float__label {
      opacity: 1;
      transform: translateX(0);
    }

    .whatsapp-float--hidden {
      opacity: 0;
      transform: translateY(12px);
      pointer-events: none;
    }

    @keyframes whatsapp-float-in {
      from {
        opacity: 0;
        transform: translateY(16px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }

    @media (max-width: 749px) {
      .whatsapp-float {
        right: 16px;
        bottom: calc(76px + var(--aw-float-lift, 0px));
        height: 56px;
        max-width: 56px;
      }

      .whatsapp-float__icon {
        flex-basis: 56px;
        height: 56px;
      }

      .whatsapp-float__icon svg {
        width: 27px;
        height: 27px;
      }

      .whatsapp-float:hover,
      .whatsapp-float:focus-visible {
        max-width: 56px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .whatsapp-float,
      .whatsapp-float__label {
        animation: none !important;
        transition: none !important;
      }
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const floatButton = document.querySelector('.whatsapp-float');
      const cartDrawer = document.querySelector('cart-drawer');
      if (!floatButton || !cartDrawer || window.Shopify?.designMode) return;

      const syncVisibility = () => {
        floatButton.classList.toggle('whatsapp-float--hidden', cartDrawer.classList.contains('active'));
      };

      syncVisibility();
      new MutationObserver(syncVisibility).observe(cartDrawer, {
        attributes: true,
        attributeFilter: ['class'],
      });
    });
  </script>
{%- endif -%}