{% comment %}
  Renders one "pick N from collection X" group inside an offer page.

  Accepts:
  - group_index {Number} zero-based index, used for ids and JS grouping
  - group_heading {String} e.g. "Choose 2 items from Modern Collection"
  - group_products {Array<Product>} hand-picked products for this group. Highest
    priority: when set, the collections below are ignored entirely.
  - group_collection {Collection} the eligible products (single-collection mode)
  - group_collections {String} comma-separated collection handles to merge into
    one picker, e.g. "men, women, unisex" (multi-collection mode; products are
    deduped across collections). Wins over group_collection when both set.

  Source priority: group_products > group_collections > group_collection.
  - group_pick_count {Number} how many items must be picked from this group
  - group_open {Boolean} whether the accordion starts expanded
  - offer_product {Product} the offer product itself (excluded from the grid)
  - block_attributes {String} block.shopify_attributes, when rendered from a block

  Usage:
  {% render 'offer-group',
     group_index: 0,
     group_heading: 'Choose 2 items',
     group_collection: collections['modern'],
     group_pick_count: 2,
     group_open: true,
     offer_product: product %}
{% endcomment %}

{%- liquid
  if group_products != blank and group_products.size > 0
    # hand-picked in the theme editor — exactly these products, in this order
    assign grid_products = group_products
    assign group_products_count = group_products.size
    assign title_list = blank
  elsif group_collections != blank
    assign handles_list = group_collections | split: ','
    assign first_handle = handles_list | first | strip
    assign merged_products = collections[first_handle].products
    assign title_list = collections[first_handle].title
    for h in handles_list offset: 1
      assign h_clean = h | strip
      assign col = collections[h_clean]
      if col != blank
        assign merged_products = merged_products | concat: col.products
        assign title_list = title_list | append: ', ' | append: col.title
      endif
    endfor
    assign group_products_count = merged_products.size
    assign grid_products = merged_products
  else
    assign grid_products = group_collection.products
    assign group_products_count = group_collection.products_count
    assign title_list = group_collection.title
  endif

  assign heading = group_heading
  if heading == blank
    assign heading = 'Choose ' | append: group_pick_count | append: ' items'
    if title_list != blank
      assign heading = heading | append: ' from ' | append: title_list
    endif
  endif

  assign seen_ids = ''
-%}

<div
  class="offer-group"
  data-offer-group
  data-group-index="{{ group_index }}"
  data-group-pick-count="{{ group_pick_count }}"
  data-group-name="{{ heading | escape }}"
  {{ block_attributes }}
>
  <details class="offer-group__details" {% if group_open %}open{% endif %}>
    <summary class="offer-group__summary">
      <span class="offer-group__summary-main">
        <span class="offer-group__summary-text">{{ heading }}</span>
      </span>
      <span class="offer-group__summary-meta">
        <span class="offer-group__pill" data-group-counter>0 / {{ group_pick_count }}</span>
        <span class="offer-group__toggle" aria-hidden="true">
          {% render 'icon-caret' %}
        </span>
      </span>
    </summary>

    <div class="offer-group__content">
      {%- if group_products_count == 0 -%}
        <p class="offer-group__empty">
          {%- if request.design_mode -%}
            Choose the products for this group in the theme editor — either
            hand-pick them under &ldquo;Products&rdquo; or select a collection.
          {%- else -%}
            These items are being restocked. Please check back soon.
          {%- endif -%}
        </p>
      {%- else -%}
        <div class="offer-grid-wrap">
          <div class="offer-grid__nav" role="group" aria-label="Browse products">
            <button type="button" class="offer-grid__arrow offer-grid__arrow--prev" data-offer-grid-prev aria-label="Scroll left">
              {% render 'icon-arrow' %}
            </button>
            <button type="button" class="offer-grid__arrow offer-grid__arrow--next" data-offer-grid-next aria-label="Scroll right">
              {% render 'icon-arrow' %}
            </button>
          </div>
          <div class="offer-grid" data-offer-grid>
          {%- for item in grid_products -%}
            {%- if forloop.index > 60 -%}
              {%- break -%}
            {%- endif -%}
            {%- assign item_id_str = item.id | append: ',' -%}
            {%- if seen_ids contains item_id_str -%}
              {%- continue -%}
            {%- endif -%}
            {%- assign seen_ids = seen_ids | append: item_id_str -%}
            {%- if item.id == offer_product.id -%}
              {%- continue -%}
            {%- endif -%}
            {%- liquid
              assign variant = item.selected_or_first_available_variant
              assign card_id = 'OfferCard-' | append: group_index | append: '-' | append: forloop.index
              assign item_alt = item.title | escape
            -%}
            <div
              class="offer-card{% unless item.available %} offer-card--soldout{% endunless %}"
              data-offer-card
              data-group-index="{{ group_index }}"
              data-variant-id="{{ variant.id }}"
              data-product-title="{{ item.title | escape }}"
              data-variant-title="{{ variant.title | escape }}"
              data-price="{{ variant.price }}"
              data-available="{{ variant.available }}"
            >
              <div class="offer-card__media">
                {%- if item.featured_image -%}
                  {{
                    item.featured_image
                    | image_url: width: 600
                    | image_tag:
                      loading: 'lazy',
                      widths: '240, 360, 480, 600',
                      sizes: '(min-width: 990px) 22vw, (min-width: 750px) 30vw, 56vw',
                      class: 'offer-card__image',
                      alt: item_alt
                  }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg offer-card__image' }}
                {%- endif -%}
                <span class="offer-card__check" aria-hidden="true">{% render 'icon-checkmark' %}</span>
              </div>

              <div class="offer-card__body">
                <h3 class="offer-card__title">{{ item.title | escape }}</h3>

                {%- unless item.has_only_default_variant -%}
                  <div class="offer-card__variant-row">
                    <label class="offer-card__variant-label" for="{{ card_id }}-variant">
                      {{- item.options.first -}}:
                    </label>
                    <div class="select offer-card__variant-select">
                      <select class="offer-card__variant select__select" id="{{ card_id }}-variant" data-offer-variant>
                        {%- for v in item.variants -%}
                          <option
                            value="{{ v.id }}"
                            data-price="{{ v.price }}"
                            data-price-formatted="{{ v.price | money_without_trailing_zeros | replace: 'Rs.', '₹' | replace: '₹ ', '₹' }}"
                            data-variant-title="{{ v.title | escape }}"
                            data-available="{{ v.available }}"
                            {% if v.id == variant.id %}
                              selected
                            {% endif %}
                            {% unless v.available %}
                              disabled
                            {% endunless %}
                          >
                            {{- v.title -}}
                          </option>
                        {%- endfor -%}
                      </select>
                      {% render 'icon-caret' %}
                    </div>
                  </div>
                {%- endunless -%}

                <div class="offer-card__price" data-offer-price>{{ variant.price | money_without_trailing_zeros | replace: 'Rs.', '₹' | replace: '₹ ', '₹' }}</div>

                <button
                  type="button"
                  class="offer-card__add"
                  data-offer-card-add
                  {% unless item.available %}
                    disabled
                  {% endunless %}
                >
                  {%- if item.available -%}
                    {{ add_label | default: 'Add to bundle' }}
                  {%- else -%}
                    {{ soldout_label | default: 'Sold out' }}
                  {%- endif -%}
                </button>

                <div class="offer-card__qty" data-offer-card-qty hidden>
                  <button type="button" class="offer-card__qty-btn" data-offer-qty-minus aria-label="Decrease quantity">
                    {% render 'icon-minus' %}
                  </button>
                  <span class="offer-card__qty-value" data-offer-qty-value>1</span>
                  <button type="button" class="offer-card__qty-btn" data-offer-qty-plus aria-label="Increase quantity">
                    {% render 'icon-plus' %}
                  </button>
                </div>
              </div>
            </div>
          {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </details>
</div>
