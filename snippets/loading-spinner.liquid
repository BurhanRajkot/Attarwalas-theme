{% comment %}
  Renders loading-spinner.
  Accepts:
    - class: {string} css classes to replace the default ones (optional)

  Usage:
  {% render 'loading-spinner' %}
{% endcomment %}

{%- comment -%}
  component-loading-spinner.css is loaded once in theme.liquid rather than here. This snippet
  is rendered many times per page (once per add-to-cart button, product card, etc.) and a
  stylesheet_tag inside it emitted one render-blocking <link> for every single render — nine
  of them on the homepage alone, all for the same 998-byte file.
{%- endcomment -%}

<div class="{% if class %}{{ class }}{% else %}loading__spinner hidden{% endif %}">
  <svg
    aria-hidden="true"
    focusable="false"
    class="spinner"
    viewBox="0 0 66 66"
    xmlns="http://www.w3.org/2000/svg"
  >
    <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
  </svg>
</div>
