{%- comment -%}
  Site-wide JSON-LD: Organization (every page), WebSite + search (homepage),
  Store / LocalBusiness (homepage, About, Contact) and BreadcrumbList
  (products, collections, pages). Product JSON-LD stays in main-product.

  Business details come from Theme settings → SEO.
{%- endcomment -%}
{%- liquid
  assign sd_origin = request.origin
  assign sd_logo = ''
  if settings.logo != blank
    assign sd_logo = settings.logo | image_url: width: 600 | prepend: 'https:'
  endif

  # Social profiles: only the ones actually set, without share-tracking
  # query strings (the YouTube link carried ?si=…).
  assign sd_social_raw = settings.social_facebook_link | append: '|' | append: settings.social_instagram_link | append: '|' | append: settings.social_youtube_link | append: '|' | append: settings.social_twitter_link | append: '|' | append: settings.social_tiktok_link | append: '|' | append: settings.social_pinterest_link | append: '|' | append: settings.social_snapchat_link | append: '|' | append: settings.social_tumblr_link | append: '|' | append: settings.social_vimeo_link
  assign sd_social_list = sd_social_raw | split: '|'
  assign sd_same_as = ''
  for link in sd_social_list
    assign clean = link | split: '?' | first | strip
    if clean != blank
      assign sd_same_as = sd_same_as | append: clean | append: '|'
    endif
  endfor
  assign sd_same_as = sd_same_as | split: '|'

  assign sd_show_local = false
  if settings.seo_business_street != blank
    if request.page_type == 'index'
      assign sd_show_local = true
    elsif request.page_type == 'page'
      if page.handle == 'about-us' or page.handle == 'contact'
        assign sd_show_local = true
      endif
    endif
  endif
-%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": {{ sd_origin | append: '/#organization' | json }},
    "name": {{ shop.name | json }},
    {%- comment -%}
      Other ways people type the brand. Google matches brand searches and
      picks the site name shown in results partly from these.
    {%- endcomment %}
    "alternateName": ["Attarwalas", "Attarwala", "Attar Walas", "attarwalas.com"],
    "description": "Handcrafted attars and long-lasting perfumes, alcohol-based and non-alcoholic, made in Mumbai since 1998 and delivered across India.",
    "url": {{ sd_origin | append: '/' | json }},
    {%- if sd_logo != blank %}
    "logo": {{ sd_logo | json }},
    {%- endif %}
    {%- if settings.seo_business_founded != blank %}
    "foundingDate": {{ settings.seo_business_founded | json }},
    {%- endif %}
    {%- if settings.seo_business_phone != blank or settings.seo_business_email != blank %}
    "contactPoint": {
      "@type": "ContactPoint",
      {%- if settings.seo_business_phone != blank %}
      "telephone": {{ settings.seo_business_phone | json }},
      {%- endif %}
      {%- if settings.seo_business_email != blank %}
      "email": {{ settings.seo_business_email | json | replace: '@', '\u0040' }},
      {%- endif %}
      "areaServed": "IN",
      "contactType": "customer service"
    },
    {%- endif %}
    "sameAs": {{ sd_same_as | json }}
  }
</script>

{%- if request.page_type == 'index' -%}
  {%- assign sd_search_target = sd_origin | append: routes.search_url | append: '?q={search_term_string}' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": {{ sd_origin | append: '/#website' | json }},
      "name": {{ shop.name | json }},
      "alternateName": ["Attarwalas", "attarwalas.com"],
      "url": {{ sd_origin | append: '/' | json }},
      "publisher": { "@id": {{ sd_origin | append: '/#organization' | json }} },
      "inLanguage": {{ request.locale.iso_code | append: '-' | append: localization.country.iso_code | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": {{ sd_search_target | json }}
        },
        "query-input": "required name=search_term_string"
      }
    }
  </script>
{%- endif -%}

{%- if sd_show_local -%}
  {%- assign sd_days = settings.seo_business_opening_days | split: ',' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Store",
      "@id": {{ sd_origin | append: '/#store' | json }},
      "name": {{ shop.name | json }},
      "url": {{ sd_origin | append: '/' | json }},
      "parentOrganization": { "@id": {{ sd_origin | append: '/#organization' | json }} },
      {%- if sd_logo != blank %}
      "image": {{ sd_logo | json }},
      "logo": {{ sd_logo | json }},
      {%- endif %}
      {%- if settings.seo_business_phone != blank %}
      "telephone": {{ settings.seo_business_phone | json }},
      {%- endif %}
      {%- if settings.seo_business_email != blank %}
      "email": {{ settings.seo_business_email | json | replace: '@', '\u0040' }},
      {%- endif %}
      "priceRange": "₹₹",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": {{ settings.seo_business_street | json }},
        "addressLocality": {{ settings.seo_business_city | json }},
        "addressRegion": {{ settings.seo_business_region | json }},
        "postalCode": {{ settings.seo_business_postcode | json }},
        "addressCountry": "IN"
      },
      {%- if settings.seo_business_latitude != blank and settings.seo_business_longitude != blank %}
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": {{ settings.seo_business_latitude | strip }},
        "longitude": {{ settings.seo_business_longitude | strip }}
      },
      {%- endif %}
      {%- capture sd_map_query -%}{{ settings.seo_business_street }}, {{ settings.seo_business_city }}, {{ settings.seo_business_region }} {{ settings.seo_business_postcode }}{%- endcapture -%}
      {%- assign sd_map_query = sd_map_query | url_encode -%}
      "hasMap": {{ 'https://www.google.com/maps/search/?api=1&query=' | append: sd_map_query | json }},
      {%- if settings.seo_business_opens != blank and sd_days.size > 0 %}
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": [
            {%- for day in sd_days -%}
              {{ day | strip | json }}{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ],
          "opens": {{ settings.seo_business_opens | json }},
          "closes": {{ settings.seo_business_closes | json }}
        }
      ],
      {%- endif %}
      "areaServed": "IN"
    }
  </script>
{%- endif -%}

{%- comment -%} Breadcrumbs: Home › [Collection ›] Product, Home › Collection, Home › Page {%- endcomment -%}
{%- liquid
  assign sd_crumb_name = ''
  assign sd_crumb_mid_name = ''
  assign sd_crumb_mid_url = ''
  case request.page_type
    when 'product'
      assign sd_crumb_name = product.title
      if collection
        assign sd_crumb_mid_name = collection.title
        assign sd_crumb_mid_url = collection.url
      endif
    when 'collection'
      assign sd_crumb_name = collection.title
      if collection.handle == 'all'
        assign sd_crumb_name = 'All products'
      endif
    when 'page'
      assign sd_crumb_name = page.title
    when 'article'
      assign sd_crumb_mid_name = blog.title
      assign sd_crumb_mid_url = blog.url
      assign sd_crumb_name = article.title
    when 'blog'
      assign sd_crumb_name = blog.title
  endcase
-%}
{%- if sd_crumb_name != blank -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": {{ sd_origin | append: '/' | json }}
        },
        {%- if sd_crumb_mid_name != blank %}
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ sd_crumb_mid_name | json }},
          "item": {{ sd_origin | append: sd_crumb_mid_url | json }}
        },
        {%- endif %}
        {
          "@type": "ListItem",
          "position": {% if sd_crumb_mid_name != blank %}3{% else %}2{% endif %},
          "name": {{ sd_crumb_name | json }},
          "item": {{ canonical_url | json }}
        }
      ]
    }
  </script>
{%- endif -%}
