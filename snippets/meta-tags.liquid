{%- comment -%}
  Accepts:
  - title: {String} page title (optional, falls back to page_title)
  - description: {String} meta description (optional, falls back to page_description)
{%- endcomment -%}
{%- liquid
  assign og_title = title | default: page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = description | default: page_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">

{%- comment -%}
  Every page except products, collections and articles (whose page_image is
  their own photo) shares
  assets/aw-share-image.jpg: 1200×630, the size Google, WhatsApp and Facebook
  previews are built for, showing the wordmark and the Signature bottles.
  Before, they fell back to the 466×432 logo set in Preferences, which
  previews crop badly. Set in the theme because the Preferences image picker
  can't be scripted; uploading a new image there has no effect while this is
  in place.
{%- endcomment -%}
{%- assign og_image = page_image -%}
{%- liquid
  assign use_share_image = true
  if og_image != blank
    case request.page_type
      when 'product', 'collection', 'article'
        assign use_share_image = false
    endcase
  endif
-%}
{%- if use_share_image -%}
  {%- assign share_url = 'aw-share-image.jpg' | asset_url | prepend: 'https:' -%}
  <meta property="og:image" content="{{ share_url }}">
  <meta property="og:image:secure_url" content="{{ share_url }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ shop.name }} – handcrafted attars and perfumes, Mumbai">
  <meta name="twitter:image" content="{{ share_url }}">
{%- elsif og_image -%}
  <meta property="og:image" content="https:{{ og_image | image_url }}">
  <meta property="og:image:secure_url" content="https:{{ og_image | image_url }}">
  <meta property="og:image:width" content="{{ og_image.width }}">
  <meta property="og:image:height" content="{{ og_image.height }}">
  <meta property="og:image:alt" content="{{ og_image.alt | default: og_title | escape }}">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta name="twitter:site" content="{{ settings.social_twitter_link | split: '.com/' | last | split: '?' | first | remove: '/' | prepend: '@' }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
