{%- liquid
  comment
    Bundle offer tickets — the "GET ANY 2 / 3 / 5" coupon carousel shown on the
    product page (rendered from a custom-liquid section in templates/product.json).

    Renders one ticket per product in the `offer` collection; each ticket links to
    that product's offer page (the offer builder). Colours follow the active theme
    scheme (CSS vars), so it always matches the site.

    Optional params:
    - eyebrow  {String} small caps line above the title ('none' hides the header)
    - heading  {String} section title
    - subtitle {String} supporting line under the title
  endcomment

  assign ticket_offers = collections['offer'].products | sort: 'title'
  assign ticket_eyebrow = eyebrow | default: 'Bundle offers'
  assign ticket_heading = heading | default: 'Buy more, pay less'
  assign ticket_subtitle = subtitle | default: 'Mix and match your favourite fragrances and pay one flat bundle price.'
-%}

{%- if ticket_offers != blank and ticket_offers.size > 0 -%}
  {%- assign ticket_count = ticket_offers.size -%}
{%- elsif request.design_mode -%}
  {%- comment -%}
    Placeholder tickets, so the section isn't an empty void while you're
    building it in the theme editor. They're inert (not links) and they swap out
    automatically once the `offer` collection has products visible to the Online
    Store channel. Design mode ONLY — on the live storefront an empty `offer`
    collection renders nothing at all, because dead tickets pointing at a
    fallback URL are worse than no tickets.
  {%- endcomment -%}
  {%- assign ticket_count = 3 -%}
  {%- assign design_preview = true -%}
{%- else -%}
  {%- assign ticket_count = 0 -%}
{%- endif -%}

{%- if ticket_count > 0 -%}
  {{ 'component-offer-ticket.css' | asset_url | stylesheet_tag }}

  <div class="aw-offers" data-aw-offers>
    {%- if ticket_eyebrow != 'none' -%}
      <div class="aw-offers__header">
        {%- if ticket_eyebrow != blank -%}
          <span class="aw-offers__eyebrow">{{ ticket_eyebrow }}</span>
        {%- endif -%}
        {%- if ticket_heading != blank -%}
          <h2 class="aw-offers__title">{{ ticket_heading }}</h2>
        {%- endif -%}
        {%- if ticket_subtitle != blank -%}
          <p class="aw-offers__subtitle">{{ ticket_subtitle }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="aw-offers__wrapper">
      <button
        class="aw-offers__arrow aw-offers__arrow--left"
        type="button"
        aria-label="Previous offer"
        data-aw-offer-prev
      >
        <span></span>
      </button>

      <div class="aw-offers__track" data-aw-offer-track>
        {%- if design_preview -%}
          {%- assign preview_counts = '2,3,5' | split: ',' -%}
          {%- assign preview_discounts = '10% off|15% off|20% off' | split: '|' -%}
          {%- for n in preview_counts -%}
            <div class="aw-ticket">
              <span class="aw-ticket__body">
                <span class="aw-ticket__label">Bundle offer</span>
                <span class="aw-ticket__count">
                  <span class="aw-ticket__count-word">Buy</span>
                  <span class="aw-ticket__count-num">{{ n }}</span>
                </span>
                <span class="aw-ticket__price">
                  <span class="aw-ticket__price-value">{{ preview_discounts[forloop.index0] }}</span>
                </span>
                <span class="aw-ticket__tagline">Mix and match any {{ n }} perfumes from the collection.</span>
              </span>
              <span class="aw-ticket__perf" aria-hidden="true"></span>
              <span class="aw-ticket__cta">
                <span>Shop this offer</span>
                {% render 'icon-arrow' %}
              </span>
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for offer in ticket_offers -%}
            {%- liquid
              assign mf = offer.metafields.offer
              assign badge_text = mf.badge.value
              assign tagline_text = mf.tagline.value
              assign pick_count = mf.pick_count.value | plus: 0

              if pick_count == 0
                if offer.handle contains '-2' or offer.title contains ' 2' or offer.title contains ' 2 '
                  assign pick_count = 2
                elsif offer.handle contains '-3' or offer.title contains ' 3' or offer.title contains ' 3 '
                  assign pick_count = 3
                elsif offer.handle contains '-5' or offer.title contains ' 5' or offer.title contains ' 5 '
                  assign pick_count = 5
                endif
              endif

              # ₹ reads better than the store's "Rs." money format on these cards
              assign price_text = offer.price | money_without_trailing_zeros | replace: 'Rs.', '₹' | replace: '₹ ', '₹'

              assign discount_type = mf.discount_type.value | default: 'percent' | downcase
              assign discount_amount = mf.discount_amount.value | plus: 0

              # Enforce correct discount values: Offer for 2 is 10%, Offer for 3 is 15%, Offer for 5 is 20%
              if pick_count == 2 or offer.handle == 'offer-for-2'
                assign discount_amount = 10
                assign discount_type = 'percent'
              elsif pick_count == 3 or offer.handle == 'offer-for-3'
                assign discount_amount = 15
                assign discount_type = 'percent'
              elsif pick_count == 5 or offer.handle == 'offer-for-5'
                assign discount_amount = 20
                assign discount_type = 'percent'
              endif

              # whole-number discounts read as "10% off", not "10.0% off"
              assign discount_amount_display = discount_amount
              assign discount_amount_rounded = discount_amount | round
              if discount_amount_rounded == discount_amount
                assign discount_amount_display = discount_amount_rounded
              endif
              assign use_discount = false
              if discount_type == 'fixed' or discount_type == 'percent'
                if discount_amount > 0
                  assign use_discount = true
                endif
              endif
              if use_discount
                if discount_type == 'fixed'
                  assign discount_money = discount_amount | times: 100 | money_without_trailing_zeros | replace: 'Rs.', '₹' | replace: '₹ ', '₹'
                  assign discount_text = 'Flat ' | append: discount_money | append: ' off'
                else
                  assign discount_text = discount_amount_display | append: '% off'
                endif
              endif

              if tagline_text contains 'and pay just' or tagline_text contains 'and pay only' or tagline_text == blank
                if pick_count > 0
                  assign tagline_text = 'Mix and match any ' | append: pick_count | append: ' perfumes from the collection.'
                else
                  assign tagline_text = offer.title
                endif
              endif
            -%}

            <a class="aw-ticket" href="{{ offer.url }}">
              <span class="aw-ticket__body">
                <span class="aw-ticket__label">Bundle offer</span>

                {%- if pick_count > 0 -%}
                  <span class="aw-ticket__count">
                    <span class="aw-ticket__count-word">Buy</span>
                    <span class="aw-ticket__count-num">{{ pick_count }}</span>
                  </span>
                {%- elsif badge_text != blank -%}
                  <span class="aw-ticket__headline">{{ badge_text }}</span>
                {%- else -%}
                  <span class="aw-ticket__headline">{{ offer.title | escape }}</span>
                {%- endif -%}

                {%- comment -%}
                  A zero price means the offer product has no price set in admin —
                  show no price at all rather than "for ₹0".
                {%- endcomment -%}
                {%- if use_discount -%}
                  <span class="aw-ticket__price">
                    <span class="aw-ticket__price-value">{{ discount_text }}</span>
                  </span>
                {%- elsif offer.price > 0 -%}
                  <span class="aw-ticket__price">
                    <span class="aw-ticket__price-word">for just</span>
                    <span class="aw-ticket__price-value">{{ price_text }}</span>
                  </span>
                {%- endif -%}

                <span class="aw-ticket__tagline">{{ tagline_text }}</span>
              </span>

              <span class="aw-ticket__perf" aria-hidden="true"></span>

              <span class="aw-ticket__cta">
                <span>Shop this offer</span>
                {% render 'icon-arrow' %}
              </span>
            </a>
          {%- endfor -%}
        {%- endif -%}
      </div>

      <button
        class="aw-offers__arrow aw-offers__arrow--right"
        type="button"
        aria-label="Next offer"
        data-aw-offer-next
      >
        <span></span>
      </button>
    </div>
  </div>

  <script>
    (function () {
      const init = function (root) {
        if (root.dataset.awOffersReady === 'true') return;
        root.dataset.awOffersReady = 'true';

        const track = root.querySelector('[data-aw-offer-track]');
        const next = root.querySelector('[data-aw-offer-next]');
        const prev = root.querySelector('[data-aw-offer-prev]');

        if (!track || !next || !prev) return;

        const step = function () {
          const card = track.querySelector('.aw-ticket');
          if (!card) return 300;
          return card.offsetWidth + 20;
        };

        // Arrows only earn their space when the row actually overflows, and
        // grey out at either end so the row never looks broken.
        const sync = function () {
          const overflows = track.scrollWidth - track.clientWidth > 4;
          next.hidden = !overflows;
          prev.hidden = !overflows;
          if (!overflows) return;
          prev.disabled = track.scrollLeft <= 4;
          next.disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - 4;
        };

        next.addEventListener('click', function () {
          track.scrollBy({ left: step(), behavior: 'smooth' });
        });

        prev.addEventListener('click', function () {
          track.scrollBy({ left: -step(), behavior: 'smooth' });
        });

        track.addEventListener('scroll', sync, { passive: true });
        window.addEventListener('resize', sync);
        sync();
      };

      document.querySelectorAll('[data-aw-offers]').forEach(init);
    })();
  </script>
{%- endif -%}
