{% comment %}
  Keeps the floating launchers (the WhatsApp button and the Shopify Inbox chat
  bubble) clear of whatever is pinned to the bottom of the viewport, so they can
  never sit on top of a primary CTA.

  Why this is needed:
  - Shopify Inbox renders `<shopify-chat>` as a full-viewport fixed host at
    z-index 2147483000. It always paints above theme content and can't be
    re-stacked from here — but raising the *host's* bottom edge lifts the bubble
    inside it, which is what this does.
  - Two bottom-pinned bars were being covered on mobile, hiding the buy button:
    `<product-sticky-bar>` on the product page (fixed, ~74px) and
    `.offer-builder__bar` on the offer pages (sticky, ~109px).

  How it works: on scroll/resize, measure any bottom-pinned bar that currently
  crosses the bottom edge of the viewport and publish its height as
  `--aw-float-lift`. Both launchers offset themselves by that value, so they
  ride above the bar while it's showing and drop back down when it isn't.

  Add `data-floating-clear` to any future bottom-pinned bar to opt it in.

  A fixed bar that slides in (the product sticky bar: translateY + transition)
  is counted at its full height as soon as it's shown, not measured mid-slide:
  measuring its rect on the scroll event caught it still off-screen, the lift
  stayed 0, and the chat bubble sat on the sticky Add to cart until the next
  scroll — on some phones and not others, depending on timing. The bar fires
  `aw:floating-change` when it shows/hides so the lift is recomputed then too.

  In-page buy controls (Add to cart / Buy Now, the free-perfume picker) can't
  be cleared by lifting — they scroll through the corner the launchers sit
  in. While one of them is passing through that corner the launchers step
  aside (`html.aw-float-hide`) so a tap always lands on the button, never on
  the chat. Add `data-floating-avoid` to opt other controls in.

  On mobile, the Shopify Inbox chat bubble is also hidden outright while the
  cart drawer is open (`html.aw-cart-open`, below) — the drawer already
  covers most of the screen at that width, so the bubble has nowhere to sit
  that isn't on top of cart content.

  Usage:
  {% render 'floating-stack' %}
{% endcomment %}

<style>
  /* Shopify Inbox's launcher sits at the bottom of its full-viewport host, so
     lifting the host's bottom edge lifts the bubble. At a lift of 0 this is
     identical to Inbox's own default positioning. */
  shopify-chat {
    bottom: var(--aw-float-lift, 0px) !important;
    height: auto !important;
    transition: bottom var(--duration-default, 0.2s) ease;
  }

  html.aw-float-hide .whatsapp-float {
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }

  /* Inbox's launcher, nested in its own shadow roots, forces visibility:
     visible and pointer-events: auto on itself, so faded out it still took
     the tap. Only display: none on the host actually gets it out of the way. */
  html.aw-float-hide shopify-chat {
    display: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    shopify-chat {
      transition: none !important;
    }
  }

  @media (max-width: 749px) {
    html.aw-cart-open shopify-chat {
      display: none !important;
    }
  }
</style>

<script>
  (function () {
    if (window.__awFloatingStack) return;
    window.__awFloatingStack = true;

    var root = document.documentElement;
    // Bottom-pinned bars that the launchers must stay clear of.
    var SELECTOR = 'product-sticky-bar.is-visible, .offer-builder__bar, [data-floating-clear]';
    // In-page controls the launchers must never cover (see the comment above).
    var AVOID = '.product-form__buttons, product-gift-picker, [data-floating-avoid]';
    var GAP = 8; // breathing room between the bar and the lowest launcher
    // The corner the launchers occupy, above the lift: Inbox's bubble plus the
    // WhatsApp button stacked over it (snippets/whatsapp-floating.liquid).
    var ZONE_HEIGHT = 170;
    var ZONE_WIDTH = 220;
    var frame = null;
    var timer = null;
    var lastLift = -1;
    var lastHide = null;

    function measure() {
      frame = null;

      var viewportHeight = window.innerHeight;
      var lift = 0;

      document.querySelectorAll(SELECTOR).forEach(function (bar) {
        var rect = bar.getBoundingClientRect();
        if (rect.height === 0 || rect.width === 0) return;

        // A fixed bar is pinned by definition; offsetHeight ignores the
        // slide-in transform, so it's right even mid-transition.
        if (getComputedStyle(bar).position === 'fixed') {
          lift = Math.max(lift, bar.offsetHeight + GAP);
          return;
        }

        // Only count a bar while it's actually spanning the bottom edge —
        // a sticky bar scrolled up mid-page shouldn't push the launchers.
        var pinnedToBottom = rect.bottom >= viewportHeight - 4 && rect.top < viewportHeight;
        if (!pinnedToBottom) return;

        lift = Math.max(lift, viewportHeight - rect.top + GAP);
      });

      if (lift !== lastLift) {
        lastLift = lift;
        root.style.setProperty('--aw-float-lift', lift + 'px');
      }

      var zoneBottom = viewportHeight - lift;
      var zoneTop = zoneBottom - ZONE_HEIGHT;
      var zoneLeft = window.innerWidth - ZONE_WIDTH;
      var hide = false;
      document.querySelectorAll(AVOID).forEach(function (el) {
        if (hide) return;
        var rect = el.getBoundingClientRect();
        if (rect.height === 0 || rect.width === 0) return;
        hide = rect.top < zoneBottom && rect.bottom > zoneTop && rect.right > zoneLeft;
      });

      if (hide !== lastHide) {
        lastHide = hide;
        root.classList.toggle('aw-float-hide', hide);
      }
    }

    function schedule() {
      if (frame !== null) return;
      frame = requestAnimationFrame(measure);

      // requestAnimationFrame is starved while a tab is backgrounded or the
      // window is occluded, and it can stay starved after the tab is restored
      // until the next paint. Without this fallback the launchers would keep
      // their stale offset and could sit on top of a CTA.
      if (timer !== null) clearTimeout(timer);
      timer = setTimeout(function () {
        timer = null;
        if (frame === null) return;
        cancelAnimationFrame(frame);
        measure();
      }, 250);
    }

    ['scroll', 'resize', 'orientationchange', 'aw:floating-change'].forEach(function (event) {
      window.addEventListener(event, schedule, { passive: true });
    });

    // Sections re-render (cart updates, variant changes) can add or remove a bar.
    if (document.body) {
      new MutationObserver(schedule).observe(document.body, { childList: true, subtree: true });
    }

    // Hide the Inbox chat bubble outright on mobile while the cart drawer is
    // open (see the CSS above) — mirrors how the WhatsApp button already
    // reacts to the same `active` class in snippets/whatsapp-floating.liquid.
    var cartDrawer = document.querySelector('cart-drawer');
    if (cartDrawer) {
      var syncCartOpenClass = function () {
        root.classList.toggle('aw-cart-open', cartDrawer.classList.contains('active'));
      };
      syncCartOpenClass();
      new MutationObserver(syncCartOpenClass).observe(cartDrawer, {
        attributes: true,
        attributeFilter: ['class'],
      });
    }

    // Measure directly (not via schedule) on the paths that must be correct
    // before the customer can interact, so a starved frame can't leave a
    // launcher covering the buy button on first paint.
    document.addEventListener('DOMContentLoaded', measure);
    window.addEventListener('load', measure);
    document.addEventListener('visibilitychange', measure);
    measure();
  })();
</script>
