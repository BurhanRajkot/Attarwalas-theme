{% comment %}
  Renders the offer deals row — one card per offer product ("Get any 2 for
  ₹1,999", "Get any 3 …"), each linking through to that product's offer page.
  Same coupon visual language as snippets/perfume-offers.liquid.

  Accepts:
  - offer_products {Array<Product>} offers to show
  - strip_heading {String} optional heading shown above the cards
  - strip_id {String} unique id for this instance
  - exclude_offer_id {Number} optional product id to skip (e.g. the offer page
    the strip is shown on, so it never links to itself)
  - block_attributes {String} block.shopify_attributes, when rendered from a block

  Usage:
  {% render 'offer-strip', offer_products: my_products, strip_heading: 'Offers', strip_id: 'abc' %}
{% endcomment %}

{{ 'section-offer-teaser.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign deals = offer_products | where: 'available'
  if deals == blank or deals.size == 0
    assign deals = offer_products
  endif
  if exclude_offer_id != blank
    assign deals = deals | where: 'id', '!=', exclude_offer_id
  endif
-%}

{%- if deals != blank and deals.size > 0 -%}
  <div class="offer-deals" id="OfferDeals-{{ strip_id }}" {{ block_attributes }}>
    {%- if strip_heading != blank -%}
      <div class="offer-deals__heading">
        <span class="offer-deals__heading-rule" aria-hidden="true"></span>
        <span>{{ strip_heading }}</span>
        <span class="offer-deals__heading-rule" aria-hidden="true"></span>
      </div>
    {%- endif -%}

    <ul class="offer-deals__grid" role="list">
      {%- for offer in deals -%}
        {%- liquid
          assign mf = offer.metafields.offer
          assign badge_text = mf.badge.value
          assign tagline_text = mf.tagline.value
          assign pick_count = mf.pick_count.value | plus: 0

          # ₹ reads better than the store's "Rs." money format on these cards
          assign price_text = offer.price | money_without_trailing_zeros | replace: 'Rs.', '₹' | replace: '₹ ', '₹'

          assign discount_type = mf.discount_type.value | downcase
          assign discount_amount = mf.discount_amount.value | plus: 0
          # whole-number discounts read as "18% OFF", not "18.0% OFF"
          assign discount_amount_display = discount_amount
          assign discount_amount_rounded = discount_amount | round
          if discount_amount_rounded == discount_amount
            assign discount_amount_display = discount_amount_rounded
          endif
          assign use_discount = false
          if discount_type == 'fixed' or discount_type == 'percent'
            if discount_amount > 0
              assign use_discount = true
            endif
          endif
          if use_discount
            if discount_type == 'fixed'
              assign discount_money = discount_amount | times: 100 | money_without_trailing_zeros | replace: 'Rs.', '₹' | replace: '₹ ', '₹'
              assign discount_text = 'Flat ' | append: discount_money | append: ' OFF'
            else
              assign discount_text = discount_amount_display | append: '% OFF'
            endif
          endif

          if tagline_text == blank
            assign tagline_text = offer.title
          endif
        -%}
        <li class="offer-deals__item">
          <a class="offer-deal" href="{{ offer.url }}">
            <span class="offer-deal__inner">
              <span class="offer-deal__pill">
                {% render 'icon-discount' %}
                <span>Offer</span>
              </span>

              {%- if pick_count > 0 -%}
                <span class="offer-deal__count">
                  <span class="offer-deal__count-word">Get any</span>
                  <span class="offer-deal__count-num">{{ pick_count }}</span>
                </span>
              {%- elsif badge_text != blank -%}
                <span class="offer-deal__headline">{{ badge_text }}</span>
              {%- else -%}
                <span class="offer-deal__headline">{{ offer.title | escape }}</span>
              {%- endif -%}

              {%- comment -%}
                A zero price means the offer product has no price set in admin —
                show no price at all rather than "for ₹0".
              {%- endcomment -%}
              {%- if use_discount -%}
                <span class="offer-deal__price">
                  <span class="offer-deal__price-value">{{ discount_text }}</span>
                </span>
              {%- elsif offer.price > 0 -%}
                <span class="offer-deal__price">
                  <span class="offer-deal__price-word">for just</span>
                  <span class="offer-deal__price-value">{{ price_text }}</span>
                </span>
              {%- endif -%}

              <span class="offer-deal__tagline">{{ tagline_text }}</span>

              <span class="offer-deal__perf" aria-hidden="true"></span>

              <span class="offer-deal__cta">
                <span>Shop the offer</span>
                {% render 'icon-arrow' %}
              </span>
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
{%- elsif request.design_mode -%}
  <div class="offer-deals__setup-hint">
    Pick the offer products (or a collection of them) in this block's settings to
    show the offer deals here.
  </div>
{%- endif -%}
