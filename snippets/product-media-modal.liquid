{% comment %}
  Renders a product media modal. Also see 'product-media-gallery'

  Accepts:
  - product: {Object} Product liquid object
  - variant_images: {Array} Product images associated with a variant

  Usage:
  {% render 'product-media-modal' %}
{% endcomment %}

<product-modal id="ProductModal-{{ section.id }}" class="product-media-modal media-modal">
  <div
    class="product-media-modal__dialog color-{{ section.settings.color_scheme }} gradient"
    role="dialog"
    aria-label="{{ 'products.modal.label' | t }}"
    aria-modal="true"
    tabindex="-1"
  >
    <button
      id="ModalClose-{{ section.id }}"
      type="button"
      class="product-media-modal__toggle"
      aria-label="{{ 'accessibility.close' | t }}"
    >
      {% render 'icon-close' %}
    </button>

    <div
      class="product-media-modal__content color-{{ section.settings.color_scheme }} gradient"
      role="document"
      aria-label="{{ 'products.modal.label' | t }}"
      tabindex="0"
    >
      {%- liquid
        comment
          Same hide_variants scoping as product-media-gallery.liquid: it
          collapses the modal to the selected variant's image, which is
          correct for the roll-ons' color swatches but wrongly hides every
          other signature-series photo that happens to be attached to a
          Size variant (this modal has its own copy of the gallery's skip
          logic, so it needed the same collection-scoped fix — the gallery
          fix alone didn't reach the zoom modal). Keep this in sync with
          product-media-gallery.liquid if the scoping ever changes again.
        endcomment
        assign hide_variants = section.settings.hide_variants
        if hide_variants
          for product_collection in product.collections
            if product_collection.handle == 'signature-series'
              assign hide_variants = false
              break
            endif
          endfor
        endif

        if product.selected_or_first_available_variant.featured_media != null
          assign media = product.selected_or_first_available_variant.featured_media
          render 'product-media', media: media, loop: section.settings.enable_video_looping, variant_image: hide_variants
        endif
      -%}

      {%- for media in product.media -%}
        {%- liquid
          if hide_variants and variant_images contains media.src or variant_images contains media.id
            assign variant_image = true
          else
            assign variant_image = false
          endif

          unless media.id == product.selected_or_first_available_variant.featured_media.id
            render 'product-media', media: media, loop: section.settings.enable_video_looping, variant_image: variant_image
          endunless
        -%}
      {%- endfor -%}
    </div>
  </div>
</product-modal>
