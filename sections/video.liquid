{{ 'video-section.css' | asset_url | stylesheet_tag }}
{%- comment -%} Only the click-to-play layout uses deferred-media; the hero never does. {%- endcomment -%}
{%- unless section.settings.full_width -%}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
{%- endunless %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign video_id = section.settings.video.id | default: section.settings.video_url.id
  assign video_alt = section.settings.video.alt | default: section.settings.description
  assign hero_alt = video_alt | default: section.settings.heading | strip_html
  if hero_alt == blank
    assign hero_alt = shop.name | append: ' handcrafted perfumes and attars'
  endif
  assign alt = 'sections.video.load_video' | t: description: video_alt | escape
  assign poster = section.settings.video.preview_image | default: section.settings.cover_image

  if section.settings.video != null
    assign ratio_diff = section.settings.video.aspect_ratio | minus: poster.aspect_ratio | abs
    if ratio_diff < 0.01 and ratio_diff > 0
      assign fix_ratio = true
    endif
  endif
-%}

{%- capture sizes -%}
  {% if section.settings.full_width -%}
    100vw
  {%- else -%}
    (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 }}px, (min-width: 750px)
    calc(100vw - 10rem), 100vw
  {%- endif %}
{%- endcapture -%}

{%- assign video_is_mp4 = true -%}
{%- if section.settings.video == null and section.settings.video_url != null -%}
  {%- assign video_is_mp4 = false -%}
{%- endif -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="video-section isolate{% unless section.settings.full_width %} page-width{% endunless %} section-{{ section.id }}-padding">
    <div
      {% if section.settings.full_width %}
        class="page-width"
      {% endif %}
    >
      {%- unless section.settings.heading == blank -%}
        <div class="title-wrapper title-wrapper--no-top-margin{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          <h2 class="title inline-richtext {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
        </div>
      {%- endunless -%}
    </div>

    {%- if section.settings.full_width -%}
      {%- comment -%}
        Hero mode: full-width video as a banner, muted autoplay loop, cover-cropped, with
        overlay copy + premium transparent buttons.

        No connection checks or quality downgrades here by design: the video always plays
        at the highest quality source (the HD MP4 is preferred over the adaptive HLS
        stream). It does start a beat after the page, though: the sources sit in
        data-src until the poster has painted. Loaded eagerly, the 5 MB file competed
        with the poster for bandwidth and pushed Largest Contentful Paint on phones past
        10s in PageSpeed. The poster is the video's own first frame, so the hand-over
        is invisible. (Waiting for window load instead was tried first: on a real phone
        that is seconds of third-party scripts, so the site opened on a still image —
        reported as "the opening animation is gone", 2026-10-02.)
      {%- endcomment -%}
      <div class="video-section__hero" data-media-id="{{ video_id }}" data-video-hero="{{ section.id }}">
        {%- if poster != blank -%}
          {%- comment -%}
            The poster is the page's Largest Contentful Paint, so it's requested at
            quality 70: Shopify's CDN honours a `quality` URL parameter (image_url has
            no option for it, hence the append). On this sandy frame that's ~38%
            smaller (217 KB → 136 KB at 750w) with no visible difference, and it is
            only on screen until the video takes over. If the CDN ever ignores the
            parameter, the default quality comes back on its own.
          {%- endcomment -%}
          <img
            class="video-section__hero-poster"
            src="{{ poster | image_url: width: 1100 | append: '&quality=70' }}"
            srcset="
              {{ poster | image_url: width: 375 | append: '&quality=70' }} 375w,
              {{ poster | image_url: width: 750 | append: '&quality=70' }} 750w,
              {{ poster | image_url: width: 1100 | append: '&quality=70' }} 1100w,
              {{ poster | image_url: width: 1500 | append: '&quality=70' }} 1500w,
              {{ poster | image_url: width: 1920 | append: '&quality=70' }} 1920w
            "
            sizes="100vw"
            alt="{{ hero_alt | escape }}"
            fetchpriority="high"
            decoding="async"
          >
        {%- endif -%}

        {%- if video_is_mp4 -%}
          <video
            class="video-section__hero-video"
            data-hero-video
            autoplay
            muted
            loop
            playsinline
            preload="none"
            disablepictureinpicture
            tabindex="-1"
            aria-hidden="true"
          >
            {%- comment -%}
              Highest-quality MP4 sources first; the adaptive HLS stream only as a
              fallback for browsers that cannot play MP4 (e.g. older iOS Safari).
            {%- endcomment -%}
            {%- for source in section.settings.video.sources -%}
              {%- if source.mime_type == 'video/mp4' -%}
                <source data-src="{{ source.url }}" type="{{ source.mime_type }}">
              {%- endif -%}
            {%- endfor -%}
            {%- for source in section.settings.video.sources -%}
              {%- if source.mime_type != 'video/mp4' -%}
                <source data-src="{{ source.url }}" type="{{ source.mime_type }}">
              {%- endif -%}
            {%- endfor -%}
          </video>
        {%- else -%}
          <iframe
            class="video-section__hero-embed"
            src="https://www.youtube.com/embed/{{ video_id }}?enablejsapi=1&autoplay=1&mute=1&loop=1&playlist={{ video_id }}&playsinline=1"
            title="{{ section.settings.description | escape }}"
            allow="autoplay; encrypted-media"
            allowfullscreen
          ></iframe>
        {%- endif -%}
        {%- if section.settings.heading != blank or section.blocks.size > 0 -%}
          <div class="video-section__shade" aria-hidden="true"></div>
          <div class="video-section__content">
            {%- unless section.settings.heading == blank -%}
              <div class="video-section__heading">
                <h2 class="{{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
              </div>
            {%- endunless -%}
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'buttons' -%}
                  <div
                    class="video-section__buttons{% if block.settings.button_label_1 != blank and block.settings.button_label_2 != blank %} video-section__buttons--multiple{% endif %}"
                    {{ block.shopify_attributes }}
                  >
                    {%- if block.settings.button_label_1 != blank -%}
                      <a
                        {% if block.settings.button_link_1 == blank %}
                          role="link" aria-disabled="true"
                        {% else %}
                          href="{{ block.settings.button_link_1 }}"
                        {% endif %}
                        class="video-section__btn{% if block.settings.button_style_secondary_1 %} video-section__btn--outline{% else %} video-section__btn--solid{% endif %}"
                      >
                        {{- block.settings.button_label_1 | escape -}}
                      </a>
                    {%- endif -%}
                    {%- if block.settings.button_label_2 != blank -%}
                      <a
                        {% if block.settings.button_link_2 == blank %}
                          role="link" aria-disabled="true"
                        {% else %}
                          href="{{ block.settings.button_link_2 }}"
                        {% endif %}
                        class="video-section__btn{% if block.settings.button_style_secondary_2 %} video-section__btn--outline{% else %} video-section__btn--solid{% endif %}"
                      >
                        {{- block.settings.button_label_2 | escape -}}
                      </a>
                    {%- endif -%}
                  </div>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <script>
        (function () {
          var hero = document.querySelector('[data-video-hero="{{ section.id }}"]');
          if (!hero) return;

          var video = hero.querySelector('[data-hero-video]');
          if (!video) return;

          /* Size the hero so that announcement bar + header + video together fill
             exactly one viewport: the hero is the first section in normal flow
             below the header group. */
          var setHeroOffset = function () {
            var top = hero.getBoundingClientRect().top + window.pageYOffset;
            hero.style.setProperty('--aw-header-offset', top + 'px');
          };
          /* First measurement in the first frame (still before it paints)
             rather than mid-parse, where it forced a full layout. */
          requestAnimationFrame(setHeroOffset);
          window.addEventListener('resize', setHeroOffset);
          window.addEventListener('load', setHeroOffset);

          /* The video is stacked over the poster image and paints opaque black
             until it has decoded a frame, so it's held at opacity 0 (see
             video-section.css) and revealed once there's something to see.
             HAVE_CURRENT_DATA (2) is the point a frame exists; check it up
             front too, in case the file came from cache and the event already
             fired before this ran. */
          var revealVideo = function () {
            hero.classList.add('is-video-ready');
          };

          if (video.readyState >= 2) {
            revealVideo();
          } else {
            video.addEventListener('loadeddata', revealVideo, { once: true });
            /* Safari can start painting without ever firing loadeddata here. */
            video.addEventListener('playing', revealVideo, { once: true });
          }

          /* Sources go live as soon as the poster has painted (see the comment
             above the markup), then the video plays at its highest-quality
             source. Two frames after the poster's load event is after it has
             painted, so the video never competes with it; the timeout is a
             backstop for a poster that never loads. */
          var started = false;
          var startVideo = function () {
            if (started) return;
            started = true;
            video.querySelectorAll('source[data-src]').forEach(function (source) {
              source.src = source.getAttribute('data-src');
              source.removeAttribute('data-src');
            });
            video.preload = 'auto';
            video.load();
            var attempt = video.play();
            if (attempt && attempt.catch) attempt.catch(function () {});
          };
          var afterPaint = function () {
            requestAnimationFrame(function () {
              requestAnimationFrame(startVideo);
            });
          };
          var poster = hero.querySelector('.video-section__hero-poster');
          if (!poster || (poster.complete && poster.naturalWidth > 0)) {
            afterPaint();
          } else {
            poster.addEventListener('load', afterPaint, { once: true });
            poster.addEventListener('error', startVideo, { once: true });
          }
          setTimeout(startVideo, 2500);
        })();
      </script>
    {%- else -%}
      <deferred-media
        class="video-section__media deferred-media gradient global-media-settings{% if fix_ratio %} media-fit-cover{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        data-media-id="{{ video_id }}"
        {% if poster != null %}
          style="--ratio-percent: {{ 1 | divided_by: poster.aspect_ratio | times: 100 }}%;"
        {% endif %}
      >
        <button
          id="Deferred-Poster-Modal-{{ video_id }}"
          class="video-section__poster media deferred-media__poster media--landscape"
          type="button"
          aria-label="{{ alt }}"
        >
          {%- if poster != null -%}
            {{
              poster
              | image_url: width: 3840
              | image_tag: sizes: sizes, widths: '375, 750, 1100, 1500, 1780, 2000, 3000, 3840', alt: alt
            }}
          {%- else -%}
            {{ 'hero-apparel-3' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
          {%- endif -%}
          <span class="deferred-media__poster-button motion-reduce">
            {%- render 'icon-play' -%}
          </span>
        </button>
        <template>
          {%- if section.settings.video == null and section.settings.video_url != null -%}
            {%- liquid
              assign loop = ''
              if section.settings.enable_video_looping
                assign loop = '&loop=1&playlist=' | append: video_id
              endif
            -%}
            {%- if section.settings.video_url.type == 'youtube' -%}
              <iframe
                src="https://www.youtube.com/embed/{{ video_id }}?enablejsapi=1&autoplay=1{{ loop }}"
                class="js-youtube"
                allow="autoplay; encrypted-media"
                allowfullscreen
                title="{{ section.settings.description | escape }}"
              ></iframe>
            {%- else -%}
              <iframe
                src="https://player.vimeo.com/video/{{ video_id }}?autoplay=1{{ loop }}"
                class="js-vimeo"
                allow="autoplay; encrypted-media"
                allowfullscreen
                title="{{ section.settings.description | escape }}"
              ></iframe>
            {%- endif -%}
          {%- else -%}
            {{
              section.settings.video
              | video_tag:
                image_size: '1100x',
                autoplay: true,
                loop: section.settings.enable_video_looping,
                controls: true,
                muted: false
            }}
          {%- endif -%}
        </template>
      </deferred-media>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.video.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "buttons",
      "name": "t:sections.image-banner.blocks.buttons.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label_1",
          "default": "Button label",
          "label": "t:sections.image-banner.blocks.buttons.settings.button_label_1.label",
          "info": "t:sections.image-banner.blocks.buttons.settings.button_label_1.info"
        },
        {
          "type": "url",
          "id": "button_link_1",
          "label": "t:sections.image-banner.blocks.buttons.settings.button_link_1.label"
        },
        {
          "type": "checkbox",
          "id": "button_style_secondary_1",
          "default": true,
          "label": "t:sections.image-banner.blocks.buttons.settings.button_style_secondary_1.label"
        },
        {
          "type": "text",
          "id": "button_label_2",
          "label": "t:sections.image-banner.blocks.buttons.settings.button_label_2.label",
          "info": "t:sections.image-banner.blocks.buttons.settings.button_label_2.info"
        },
        {
          "type": "url",
          "id": "button_link_2",
          "label": "t:sections.image-banner.blocks.buttons.settings.button_link_2.label"
        },
        {
          "type": "checkbox",
          "id": "button_style_secondary_2",
          "default": false,
          "label": "t:sections.image-banner.blocks.buttons.settings.button_style_secondary_2.label"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Video",
      "label": "t:sections.video.settings.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "checkbox",
      "id": "enable_video_looping",
      "label": "t:sections.video.settings.enable_video_looping.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.video.settings.header__1.content"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:sections.video.settings.video.label"
    },
    {
      "type": "header",
      "content": "t:sections.video.settings.header__2.content"
    },
    {
      "type": "paragraph",
      "content": "t:sections.video.settings.paragraph.content"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube", "vimeo"],
      "default": "https://www.youtube.com/watch?v=_9VUPq3SxOc",
      "label": "t:sections.video.settings.video_url.label",
      "info": "t:sections.video.settings.video_url.info"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "t:sections.video.settings.cover_image.label"
    },
    {
      "type": "text",
      "id": "description",
      "label": "t:sections.video.settings.description.label",
      "info": "t:sections.video.settings.description.info"
    },
    {
      "type": "header",
      "content": "t:sections.video.settings.header__3.content"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.video.settings.full_width.label",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "t:sections.video.presets.name"
    }
  ]
}
{% endschema %}
