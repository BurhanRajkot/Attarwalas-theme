{%- liquid
  # A qualifying perfume in the cart earns a free gift slot; checkout is
  # blocked until every earned slot is claimed, so a customer can't skip
  # picking their free gift. Mirrors the eligibility math in
  # snippets/free-gift-picker.liquid — kept in sync manually since Liquid has
  # no way to share a computed value across snippet scopes.
  assign gift_collection = settings.free_gift_collection
  if gift_collection == blank
    assign gift_collection = collections['signature-series']
  endif

  assign qualifying_collection = settings.free_gift_qualifying_collection
  if qualifying_collection == blank
    assign qualifying_collection = collections['signature-series']
  endif

  assign gift_active = false
  if settings.free_gift_enabled and gift_collection.products_count > 0
    assign gift_active = true
  endif

  assign qualifying_units = 0
  assign claimed_units = 0
  assign gift_has_bogus_line = false
  for item in cart.items
    if item.properties._free_gift != blank
      assign claimed_units = claimed_units | plus: item.quantity
      continue
    endif

    assign in_qualifying_collection = false
    for c in item.product.collections
      if c.handle == qualifying_collection.handle
        assign in_qualifying_collection = true
        break
      endif
    endfor

    # Customize Perfume also earns a gift, same handle-based exception as
    # snippets/free-gift-picker.liquid — keep both in sync.
    if item.product.handle == 'customize-perfume-1'
      assign in_qualifying_collection = true
    endif

    if in_qualifying_collection
      if item.variant.option1 == '10ML' or item.variant.option1 == '35ML'
        # Bare gift-size line, no `_free_gift` marker — added directly, not
        # via a gift picker. Must never count as a qualifying purchase (see
        # the matching comment in snippets/free-gift-picker.liquid) and must
        # never be checkout-able either — see gift_has_bogus_line below.
        assign gift_has_bogus_line = true
      else
        assign qualifying_units = qualifying_units | plus: item.quantity
      endif
    endif
  endfor

  assign gift_pending = false
  if gift_active and qualifying_units > claimed_units
    assign gift_pending = true
  endif

  # Hard backstop, independent of free-gift.js's client-side auto-trim: if a
  # claimed gift now exceeds what the cart actually qualifies for (its
  # qualifying perfume was removed/reduced), block checkout rather than let
  # the customer pay full price for what the UI told them was free. The JS
  # trim normally clears this within one round trip; this only bites if that
  # somehow doesn't happen (JS disabled, a failed request, stale page).
  assign gift_excess = false
  if claimed_units > qualifying_units
    assign gift_excess = true
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  class="gradient color-{{ section.settings.color_scheme }}{% if cart == empty %} is-empty{% endif %}"
  id="main-cart-footer"
  data-id="{{ section.id }}"
>
  <div class="page-width">
    <div class="cart__footer isolate section-{{ section.id }}-padding">
      {%- if settings.show_cart_note -%}
        <cart-note class="cart__note field">
          <label for="Cart-note">{{ 'sections.cart.note' | t }}</label>
          <textarea
            class="text-area field__input"
            name="note"
            form="cart"
            id="Cart-note"
            placeholder="{{ 'sections.cart.note' | t }}"
          >{{ cart.note }}</textarea>
        </cart-note>
      {%- endif -%}

      {%- comment -%}
        js-contents lives on this outer wrapper, not just the subtotal block,
        so that both cart.js's quantity-change AJAX render and free-gift.js's
        own render (both of which swap `#main-cart-footer .js-contents`
        wholesale) also reach the checkout button below — its disabled state
        and the "Pick your free perfume" note depend on gift_pending, which
        changes on both kinds of update. Scoping js-contents to only the
        subtotal block (as it was before) left the button's disabled/enabled
        state frozen at whatever it was on the last full page load, since
        that markup sat outside the swapped region entirely. Reported by
        Burhan 2026-08-31: gift claimed in the cart, checkout still blocked
        with "Pick your free perfume above to continue" until a manual
        page refresh.
      {%- endcomment -%}
      <div class="cart__blocks js-contents">
        {% for block in section.blocks %}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}
            {%- when 'subtotal' -%}
              <div {{ block.shopify_attributes }}>
                <div>
                  {%- if cart.cart_level_discount_applications.size > 0 -%}
                    <ul class="discounts list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                      {%- for discount in cart.cart_level_discount_applications -%}
                        <li class="discounts__discount discounts__discount--position">
                          {%- render 'icon-discount' -%}
                          {{ discount.title }}
                          (-{{ discount.total_allocated_amount | money }})
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </div>

                <div class="totals">
                  <h2 class="totals__total">{{ 'sections.cart.estimated_total' | t }}</h2>
                  <p class="totals__total-value">{{ cart.total_price | money_with_currency }}</p>
                </div>

                <small class="tax-note caption-large rte">
                  {%- if cart.taxes_included and shop.shipping_policy.body != blank -%}
                    {{ 'sections.cart.taxes_included_and_shipping_policy_html' | t: link: shop.shipping_policy.url }}
                  {%- elsif cart.taxes_included -%}
                    {{ 'sections.cart.taxes_included_but_shipping_at_checkout' | t }}
                  {%- elsif shop.shipping_policy.body != blank -%}
                    {{ 'sections.cart.taxes_and_shipping_policy_at_checkout_html' | t: link: shop.shipping_policy.url }}
                  {%- else -%}
                    {{ 'sections.cart.taxes_and_shipping_at_checkout' | t }}
                  {%- endif -%}
                </small>
              </div>
            {%- else -%}
              <div class="cart__ctas" {{ block.shopify_attributes }}>
                <button
                  type="submit"
                  id="checkout"
                  class="cart__checkout-button button"
                  name="checkout"
                  {% if cart == empty or gift_pending or gift_excess or gift_has_bogus_line %}
                    disabled
                  {% endif %}
                  form="cart"
                >
                  {{ 'sections.cart.checkout' | t }}
                </button>
                {%- if gift_pending -%}
                  <p class="cart__gift-pending-note">Pick your free perfume above to continue.</p>
                {%- elsif gift_excess -%}
                  <p class="cart__gift-pending-note">Your free gift no longer matches your cart — click "Change" on it above to continue.</p>
                {%- elsif gift_has_bogus_line -%}
                  <p class="cart__gift-pending-note">One of your items isn't available for individual purchase — please remove it above to continue.</p>
                {%- endif -%}
              </div>

              {%- if additional_checkout_buttons and gift_pending == false and gift_excess == false and gift_has_bogus_line == false -%}
                <div class="cart__dynamic-checkout-buttons additional-checkout-buttons">
                  {{ content_for_additional_checkout_buttons }}
                </div>
              {%- endif -%}
          {%- endcase -%}
        {% endfor %}

        <div id="cart-errors"></div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-cart-footer.name",
  "class": "cart__footer-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "subtotal",
      "name": "t:sections.main-cart-footer.blocks.subtotal.name",
      "limit": 1
    },
    {
      "type": "buttons",
      "name": "t:sections.main-cart-footer.blocks.buttons.name",
      "limit": 1
    },
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
