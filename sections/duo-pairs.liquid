{{ 'section-offer-builder.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-duo-pairs.css' | asset_url | stylesheet_tag }}
{{ 'component-product-gift-picker.css' | asset_url | stylesheet_tag }}
<script src="{{ 'duo-pairs.js' | asset_url }}" defer="defer"></script>

{%- comment -%}
  Duo page: one card per signature-series fragrance, each card pairing that
  fragrance's own perfume with its own attar roll-on (matched by title, not by
  a curated list — see the pairing loop below). The customer can only change
  each item's size (ml); which fragrance and which two products are in the
  duo is fixed per card, not pickable. Always exactly 1 perfume + 1 roll-on.

  This intentionally does NOT reuse the offer-builder custom element — that
  component is built around picking N products from a shared pool across one
  or more groups,
  whereas a duo card is a single fixed pair with two independent size
  selects. Reusing it here would have meant bending its group/quantity model
  to breaking point, at real risk to every existing offer page.
{%- endcomment -%}

{%- liquid
  assign perfume_collection = section.settings.perfume_collection
  if perfume_collection == blank
    assign perfume_collection = settings.free_gift_qualifying_collection
  endif
  if perfume_collection == blank
    assign perfume_collection = collections['signature-series']
  endif

  assign rollon_collection = collections['attar-roll-ons']

  comment
    Each real duo product (Ambre Intense Duo, Yameni Yakud Duo, etc. — the
    six placeholder products in the "duo" collection) carries its own
    dedicated photos, uploaded separately from the signature-series perfume
    product's own bottle-only shots. Matched by title the same way the
    perfume/roll-on pairing already is: "<Fragrance> Duo" against the
    perfume's own title + " Duo".
  endcomment
  assign duo_collection = collections['duo']

  comment
    "All Signature Duos" back link target. Deliberately NOT product.url of
    whichever duo product happens to be showing right now — since each of
    the 6 real per-fragrance duo products is in the "Duo" collection, their
    own bare URL now triggers layout/theme.liquid's redirect straight back
    into their own hero (see CLAUDE.md's "homepage Duo carousel" gotcha),
    so that link would never reach the grid at all. Always ?view=duo forced
    too, since the grid product's own Theme template can't be set to `duo`
    yet either (same draft-theme limitation).
  endcomment
  assign all_duos_product = section.settings.all_duos_product
  if all_duos_product == blank
    assign all_duos_product = all_products['signature-duo']
  endif
  assign all_duos_url = '#'
  if all_duos_product != blank
    assign all_duos_url = all_duos_product.url | append: '?view=duo'
  endif


  comment
    Free-gift picker (added 2026-09-27): a duo's perfume is a real
    signature-series product line, so it already earns a free 10ml/35ml
    gift the same as buying that perfume on its own — but until now the
    duo hero had no picker to claim it, only the cart's own
    free-gift-picker.liquid once the customer got that far. Mirrors
    snippets/product-gift-picker.liquid's collection/variant lookup;
    see the hero loop below for the per-fragrance eligibility check and
    the picker markup itself.
  endcomment
  assign gift_qualifying_collection = settings.free_gift_qualifying_collection
  if gift_qualifying_collection == blank
    assign gift_qualifying_collection = collections['signature-series']
  endif
  assign gift_source_collection = settings.free_gift_collection
  if gift_source_collection == blank
    assign gift_source_collection = collections['signature-series']
  endif
  assign show_gift_pickers = false
  if settings.free_gift_enabled and gift_source_collection.products_count > 0
    assign show_gift_pickers = true
  endif

  assign discount_type = section.settings.discount_type | downcase
  assign discount_amount = section.settings.discount_amount | plus: 0
  assign use_discount = false
  if discount_type != 'none' and discount_type != blank and discount_amount > 0
    assign use_discount = true
  endif

  assign badge_text = section.settings.badge
  if badge_text == blank and use_discount
    if discount_type == 'fixed'
      assign discount_money = discount_amount | times: 100 | money_without_trailing_zeros | replace: 'Rs.', '₹' | replace: '₹ ', '₹'
      assign badge_text = 'Flat ' | append: discount_money | append: ' off every duo'
    else
      assign badge_text = discount_amount | append: '% off every duo'
    endif
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<duo-pairs
  id="DuoPairs-{{ section.id }}"
  class="offer-builder duo-pairs color-{{ section.settings.color_scheme }}"
  data-money-format="{{ shop.money_format | strip_html | escape }}"
  data-ready-label="{{ section.settings.button_label | escape }}"
  {% if use_discount %}
    data-discount-type="{{ discount_type }}"
    data-discount-amount="{{ discount_amount }}"
  {% endif %}
>
  <div class="page-width section-{{ section.id }}-padding" data-duo-grid-view>
    <header class="offer-builder__intro">
      {%- if badge_text != blank -%}
        <div class="offer-builder__badge">
          {% render 'icon-discount' %}
          <span>{{ badge_text }}</span>
        </div>
      {%- endif -%}

      <h1 class="offer-builder__title">{{ section.settings.heading | default: 'Signature Duos' }}</h1>

      {%- if section.settings.tagline != blank -%}
        <p class="offer-builder__tagline">{{ section.settings.tagline }}</p>
      {%- endif -%}

      {%- liquid
        if section.settings.perks != blank
          assign perks = section.settings.perks | strip | newline_to_br | replace: '<br />', '||' | strip_html | split: '||'
        endif
      -%}
      {%- if perks != blank and perks.size > 0 -%}
        <ul class="offer-builder__perks">
          {%- for perk in perks -%}
            {%- if perk != blank -%}
              <li>
                {% render 'icon-checkmark' %}
                <span>{{ perk | strip }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </header>

    {%- comment -%}
      Same list markup as the Signature Series grid
      (sections/main-collection-product-grid.liquid: ul.product-grid,
      2 up below 990px, 3 up above), so the two pages lay out identically.
    {%- endcomment -%}
    <div class="duo-browse-grid">
      {%- comment -%}
        Screen-reader/outline heading between the page title and each tile's
        h3 (the collection grid has the same, visually hidden).
      {%- endcomment -%}
      <h2 class="visually-hidden">All Signature Duos</h2>
      <ul class="grid product-grid grid--2-col-tablet-down grid--3-col-desktop" role="list">
        {%- assign rendered_count = 0 -%}
        {%- for perfume in perfume_collection.products -%}
          {%- comment -%}
            Matched by title, not handle — the roll-on handles don't follow a
            consistent "<perfume-handle>-attar-roll-on" pattern (one of the
            six is a legacy handle from before a rename), but every roll-on's
            title is its perfume's title with " Attar Roll-On" appended, which
            IS consistent. A perfume with no matching roll-on is skipped
            rather than shown with half a duo.
          {%- endcomment -%}
          {%- assign matched_rollon = blank -%}
          {%- for candidate in rollon_collection.products -%}
            {%- if candidate.title contains perfume.title -%}
              {%- assign matched_rollon = candidate -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if matched_rollon == blank -%}
            {%- continue -%}
          {%- endif -%}

          {%- comment -%}
            Perfume sizes: only 50ML/100ML are real purchasable sizes here —
            10ML/35ML exist solely to back the free-gift picker (see
            "Outstanding: 10ml/35ml perfume variants" in CLAUDE.md) and must
            never be offered for direct sale. Fixed order (not source order)
            so 50ML always lists before 100ML regardless of variant order.
          {%- endcomment -%}
          {%- assign perfume_sizes = '50ML,100ML' | split: ',' -%}
          {%- assign rollon_sizes = '6ML,12ML' | split: ',' -%}

          {%- assign perfume_variant_count = 0 -%}
          {%- for size in perfume_sizes -%}
            {%- assign found = blank -%}
            {%- for v in perfume.variants -%}
              {%- assign v_size = v.option1 | upcase -%}
              {%- if v.option1 != blank and v_size == size -%}
                {%- assign found = v -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if found != blank -%}
              {%- assign perfume_variant_count = perfume_variant_count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}

          {%- comment -%}
            Roll-on default box colour: always whichever variant comes first
            for that size (Red, consistently, across every product checked —
            see "Duo" notes in CLAUDE.md). The customer never picks colour
            here, only size, same as the brief asked for.
          {%- endcomment -%}
          {%- assign rollon_variant_count = 0 -%}
          {%- for size in rollon_sizes -%}
            {%- assign found = blank -%}
            {%- for v in matched_rollon.variants -%}
              {%- assign v_size = v.option1 | upcase -%}
              {%- if v.option1 != blank and v_size == size -%}
                {%- assign found = v -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if found != blank -%}
              {%- assign rollon_variant_count = rollon_variant_count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if perfume_variant_count == 0 or rollon_variant_count == 0 -%}
            {%- continue -%}
          {%- endif -%}

          {%- assign rendered_count = rendered_count | plus: 1 -%}
          {%- assign card_id = 'DuoCard-' | append: section.id | append: '-' | append: forloop.index0 -%}

          {%- assign duo_product = blank -%}
          {%- assign duo_title = perfume.title | append: ' Duo' -%}
          {%- for candidate in duo_collection.products -%}
            {%- if candidate.title == duo_title -%}
              {%- assign duo_product = candidate -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
          {%- comment -%}
            One photo per tile, no hover swap to a second one: every duo
            product's second photo is on a grey studio backdrop that shows as
            a hard box against the cream page (Burhan hated the hover). With
            a single image, component-card.css gives the same slow zoom a
            Signature Series card gets.
          {%- endcomment -%}
          {%- assign card_image = perfume.featured_image -%}
          {%- if duo_product != blank and duo_product.featured_image != blank -%}
            {%- assign card_image = duo_product.featured_image -%}
          {%- endif -%}

          {%- comment -%}
            Plain browse tile — no size pickers, no add-to-cart, matching the
            collection-grid look elsewhere on the site (e.g. Signature
            Series). The whole tile links to that fragrance's own dedicated
            duo product (e.g. /products/ambre-intense-duo), not back to this
            page — ?view=duo forces Shopify to render templates/product.duo.json
            on that product regardless of its own (still unassigned) Theme
            template, and &duo=<handle> tells duo-pairs.js's setupHeroView
            which single hero to show. Falls back to the current page (this
            grid's own product) if that fragrance has no matching real duo
            product yet, so a tile never dead-ends.
          {%- endcomment -%}
          {%- assign duo_href = product.url | append: '?view=duo&duo=' | append: perfume.handle -%}
          {%- if duo_product != blank -%}
            {%- assign duo_href = duo_product.url | append: '?view=duo&duo=' | append: perfume.handle -%}
          {%- endif -%}

          {%- assign duo_perfume_variant = perfume.variants | where: 'option1', '50ML' | first -%}
          {%- if duo_perfume_variant == blank -%}
            {%- assign duo_perfume_variant = perfume.variants | where: 'option1', '100ML' | first -%}
          {%- endif -%}
          {%- assign duo_rollon_variant = blank -%}
          {%- for v in matched_rollon.variants -%}
            {%- assign v_upcase_size = v.option1 | upcase -%}
            {%- if v.option1 != blank and v_upcase_size == '6ML' -%}
              {%- assign duo_rollon_variant = v -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
          {%- assign duo_from_price = 0 -%}
          {%- if duo_perfume_variant != blank -%}
            {%- assign duo_from_price = duo_from_price | plus: duo_perfume_variant.price -%}
          {%- endif -%}
          {%- if duo_rollon_variant != blank -%}
            {%- assign duo_from_price = duo_from_price | plus: duo_rollon_variant.price -%}
          {%- endif -%}

          {%- comment -%}
            Mirrors snippets/card-product.liquid's markup class-for-class
            (card-wrapper / card__inner / card__media / media--hover-effect /
            card__heading h5 / price), so component-card.css styles this tile
            exactly like a Signature Series card: same size, same serif
            uppercase title, same "From" price, same slow hover zoom. Not
            rendered through card-product itself
            because that would link to the duo product without ?view=duo and
            print the duo product's own placeholder price rather than the real
            perfume + roll-on total computed above. No quick-add pill: adding
            the duo product directly would skip the bundle entirely.

            card__media--recolor-backdrop: the duo photos are shot on white;
            multiply blends that into the page's cream, same fix card-product
            applies to Ambre Intense / Yameni Yakud.
          {%- endcomment -%}
          {%- liquid
            assign tile_ratio = 1
            if card_image != blank and card_image.aspect_ratio > 0
              assign tile_ratio = card_image.aspect_ratio
            endif
            assign tile_ratio_percent = 1 | divided_by: tile_ratio | times: 100
            assign tile_col_px = settings.page_width | minus: 120 | divided_by: 3
            assign tile_sizes = '(min-width: ' | append: settings.page_width | append: 'px) ' | append: tile_col_px | append: 'px, (min-width: 990px) calc((100vw - 120px) / 3), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)'
            assign tile_title = perfume.title | append: ' Duo' | escape
            assign duo_from_money = duo_from_price | money
          -%}
          <li
            class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ rendered_count }};"
            {% endif %}
          >
            <div class="card-wrapper product-card-wrapper underline-links-hover">
              <div
                class="card card--{{ settings.card_style }} card--media{% if settings.card_style == 'card' %} color-{{ settings.card_color_scheme }} gradient{% endif %}"
                style="--ratio-percent: {{ tile_ratio_percent }}%;"
              >
                <div
                  class="card__inner {% if settings.card_style == 'standard' %}color-{{ settings.card_color_scheme }} gradient{% endif %} ratio"
                  style="--ratio-percent: {{ tile_ratio_percent }}%;"
                >
                  <div class="card__media">
                    <div class="media media--transparent media--hover-effect card__media--recolor-backdrop">
                      {%- if card_image != blank -%}
                        {{
                          card_image
                          | image_url: width: 1066
                          | image_tag:
                            loading: 'lazy',
                            widths: '165, 360, 533, 720, 940, 1066',
                            sizes: tile_sizes,
                            class: 'motion-reduce',
                            alt: tile_title
                        }}
                      {%- else -%}
                        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                      {%- endif -%}
                    </div>
                  </div>
                  <div class="card__content">
                    <div class="card__information">
                      <h3 class="card__heading">
                        <a href="{{ duo_href }}" class="full-unstyled-link" tabindex="-1" aria-hidden="true">
                          {{- tile_title -}}
                        </a>
                      </h3>
                    </div>
                  </div>
                </div>
                <div class="card__content">
                  <div class="card__information">
                    <h3 class="card__heading h5">
                      <a href="{{ duo_href }}" class="full-unstyled-link">
                        {{- tile_title -}}
                      </a>
                    </h3>
                    {%- if duo_from_price > 0 -%}
                      <div class="card-information">
                        <div class="price">
                          <div class="price__container">
                            <div class="price__regular">
                              <span class="visually-hidden visually-hidden--inline">
                                {{- 'products.product.price.regular_price' | t -}}
                              </span>
                              <span class="price-item price-item--regular">
                                {{- 'products.product.price.from_price_html' | t: price: duo_from_money -}}
                              </span>
                            </div>
                          </div>
                        </div>
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>

    {%- if rendered_count == 0 -%}
      <p class="offer-group__empty">
        {%- if request.design_mode -%}
          No signature-series perfume currently has a matching attar roll-on
          with both 50ML/100ML (perfume) and 6ML/12ML (roll-on) variants —
          check the perfume collection setting above, and that each
          roll-on's title starts with its perfume's title.
        {%- else -%}
          Duos are being restocked. Please check back soon.
        {%- endif -%}
      </p>
    {%- endif -%}
  </div>

  {%- comment -%}
    Single-duo "product page" view: reached via ?duo=<perfume-handle> on this
    same page (e.g. from snippets/duo-teaser.liquid on a product page). Every
    hero below is rendered but hidden by default — duo-pairs.js reads the
    query param on load, shows the one matching hero and the grid view above
    stays hidden, so this reads as a dedicated page for that one fragrance
    rather than the "browse all 6" page. No query param (or no match) means
    this whole block stays hidden and the grid view above is what's shown —
    unchanged from before this existed.
  {%- endcomment -%}
  <div class="page-width duo-hero-view" data-duo-hero-view hidden>
    <a class="duo-hero__back" href="{{ all_duos_url }}">
      {% render 'icon-arrow' %}
      <span>All Signature Duos</span>
    </a>

    {%- for perfume in perfume_collection.products -%}
      {%- assign matched_rollon = blank -%}
      {%- for candidate in rollon_collection.products -%}
        {%- if candidate.title contains perfume.title -%}
          {%- assign matched_rollon = candidate -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if matched_rollon == blank -%}
        {%- continue -%}
      {%- endif -%}

      {%- assign perfume_sizes = '50ML,100ML' | split: ',' -%}
      {%- assign rollon_sizes = '6ML,12ML' | split: ',' -%}

      {%- assign perfume_variant_count = 0 -%}
      {%- for size in perfume_sizes -%}
        {%- assign found = blank -%}
        {%- for v in perfume.variants -%}
          {%- assign v_size = v.option1 | upcase -%}
          {%- if v.option1 != blank and v_size == size -%}
            {%- assign found = v -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if found != blank -%}
          {%- assign perfume_variant_count = perfume_variant_count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}

      {%- assign rollon_variant_count = 0 -%}
      {%- for size in rollon_sizes -%}
        {%- assign found = blank -%}
        {%- for v in matched_rollon.variants -%}
          {%- assign v_size = v.option1 | upcase -%}
          {%- if v.option1 != blank and v_size == size -%}
            {%- assign found = v -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if found != blank -%}
          {%- assign rollon_variant_count = rollon_variant_count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if perfume_variant_count == 0 or rollon_variant_count == 0 -%}
        {%- continue -%}
      {%- endif -%}

      {%- assign hero_id = 'DuoHero-' | append: section.id | append: '-' | append: forloop.index0 -%}

      {%- comment -%}
        This hero's own perfume must actually be in the qualifying
        collection — perfume_collection is a configurable section setting
        and could in principle point somewhere other than the real
        free-gift qualifying collection, in which case adding a gift line
        here would show as claimable but the discount function would
        refuse to zero it (it re-checks collection membership itself).
      {%- endcomment -%}
      {%- assign hero_gift_eligible = false -%}
      {%- if show_gift_pickers -%}
        {%- for c in perfume.collections -%}
          {%- if c.handle == gift_qualifying_collection.handle -%}
            {%- assign hero_gift_eligible = true -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

      {%- comment -%}
        Gallery source: the dedicated duo product's own photos (uploaded to
        the "duo" collection product, e.g. "Ambre Intense Duo" — a lifestyle
        shot of the pair, the box, the fragrance pyramid, etc.), not the
        signature-series perfume's own bottle-only images. Falls back to the
        perfume's images if a duo product doesn't exist yet or has none of
        its own, so a fragrance never renders with zero photos.
      {%- endcomment -%}
      {%- assign duo_product = blank -%}
      {%- assign duo_title = perfume.title | append: ' Duo' -%}
      {%- for candidate in duo_collection.products -%}
        {%- if candidate.title == duo_title -%}
          {%- assign duo_product = candidate -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
      {%- assign gallery_images = perfume.images -%}
      {%- if duo_product != blank and duo_product.images.size > 0 -%}
        {%- assign gallery_images = duo_product.images -%}
      {%- endif -%}
      {%- comment -%}
        The full image set is shown below. Size > 1 triggers the thumb/dots
        and counter rendering below, mimicking the main product gallery.
      {%- endcomment -%}

      {%- comment -%}
        Carries the same data-duo-card / data-duo-*-select / data-duo-price /
        data-duo-retail attributes the grid cards use — duo-pairs.js treats
        every element matching [data-duo-card] the same way (price render,
        selection), so a hero needs zero JS changes to work, only markup.
      {%- endcomment -%}
      <div
        class="duo-hero"
        data-duo-card
        data-duo-hero
        data-fragrance="{{ perfume.title | escape }}"
        data-bundle-handle="{{ perfume.handle }}"
        hidden
      >
        <div class="duo-hero__media">
          {%- if gallery_images.size > 0 -%}
            {%- comment -%}
              Entrance reveal, mirroring sections/main-product.liquid's own
              gallery/buy-box treatment (product-media-gallery.liquid's
              gallery_reveal + product__info-wrapper's scroll-trigger
              animate--slide-in below) — the duo hero had neither, so opening
              a duo page cut straight in while every real product page fades
              its photo and slides its buy column in. One fade on the whole
              frame here (not per-slide like the product gallery has to be)
              since every duo slide already lives in the DOM at once, not
              hidden behind a thumbnail — nothing to blank out mid-swipe.
            {%- endcomment -%}
            <div class="duo-hero__frame{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
              <div class="duo-hero__gallery" data-duo-gallery role="group" aria-label="{{ perfume.title | escape }} photos" tabindex="0">
              {%- for image in gallery_images -%}
                {%- assign slide_loading = 'lazy' -%}
                {%- if forloop.first -%}
                  {%- assign slide_loading = 'eager' -%}
                {%- endif -%}
                <div class="duo-hero__slide" data-duo-slide>
                  {{
                    image
                    | image_url: width: 1200
                    | image_tag:
                      loading: slide_loading,
                      widths: '480, 720, 960, 1200',
                      sizes: '(min-width: 750px) 44vw, 92vw',
                      class: 'duo-hero__image',
                      alt: perfume.title | escape
                  }}
                </div>
              {%- endfor -%}
              </div>
              {%- comment -%}
                Same floating "2 / 5" pill the product page shows over its
                gallery. It sits in .duo-hero__frame — a wrapper around the
                gallery alone — because .duo-hero__media also holds the
                thumbnail strip, and anchoring to that would park the pill
                over the thumbs instead of the photo. aria-hidden since the
                thumb buttons already announce "Show photo N of M".
              {%- endcomment -%}
              {%- if gallery_images.size > 1 -%}
                <div class="duo-hero__counter" data-duo-gallery-counter aria-hidden="true">
                  <span data-duo-counter-current>1</span>
                  <span> / </span>
                  <span>{{ gallery_images.size }}</span>
                </div>
              {%- endif -%}
            </div>
            {%- if gallery_images.size > 1 -%}
              <div class="duo-hero__thumbs" data-duo-gallery-dots>
                {%- for image in gallery_images -%}
                  <button
                    type="button"
                    class="duo-hero__thumb{% if forloop.first %} is-active{% endif %}"
                    data-duo-dot
                    data-index="{{ forloop.index0 }}"
                    aria-label="Show photo {{ forloop.index }} of {{ gallery_images.size }}"
                  >
                    {{
                      image
                      | image_url: width: 160
                      | image_tag:
                        loading: 'lazy',
                        widths: '80, 120, 160',
                        sizes: '7rem',
                        class: 'duo-hero__thumb-image',
                        alt: ''
                    }}
                  </button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg duo-hero__image' }}
          {%- endif -%}
        </div>

        <div class="duo-hero__info{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          <p class="duo-hero__eyebrow">Signature Duo</p>
          {%- comment -%}
            h2 styled as h1: every fragrance's hero is in the markup at once
            (JS shows one), and each used to be an h1 alongside the grid's
            "Signature Duos" h1 — seven per page. The grid title, which
            comes first in the markup, is the page's one h1.
          {%- endcomment -%}
          <h2 class="duo-hero__title h1">{{ perfume.title | escape }} Duo</h2>
          <p class="duo-card__subtitle">Perfume + Attar Roll-On</p>

          {%- if section.settings.tagline != blank -%}
            <p class="duo-hero__tagline">{{ section.settings.tagline }}</p>
          {%- endif -%}

          <div class="duo-size-row">
            <span class="duo-size-row__label">Perfume</span>
            <div class="duo-size-group" data-duo-perfume-group>
              {%- for size in perfume_sizes -%}
                {%- assign found = blank -%}
                {%- for v in perfume.variants -%}
                  {%- assign v_size = v.option1 | upcase -%}
                  {%- if v.option1 != blank and v_size == size -%}
                    {%- assign found = v -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- if found != blank -%}
                  <input
                    type="radio"
                    class="duo-size-input"
                    name="{{ hero_id }}-perfume-size"
                    id="{{ hero_id }}-perfume-{{ size }}"
                    value="{{ found.id }}"
                    data-price="{{ found.price }}"
                    data-size="{{ size }}"
                    {% if forloop.first %}checked{% endif %}
                    {% unless found.available %}disabled{% endunless %}
                  >
                  <label class="duo-size-label" for="{{ hero_id }}-perfume-{{ size }}">{{ size }}</label>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>

          <div class="duo-size-row">
            <span class="duo-size-row__label">Roll-on</span>
            <div class="duo-size-group" data-duo-rollon-group>
              {%- for size in rollon_sizes -%}
                {%- assign found = blank -%}
                {%- for v in matched_rollon.variants -%}
                  {%- assign v_size = v.option1 | upcase -%}
                  {%- if v.option1 != blank and v_size == size -%}
                    {%- assign found = v -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- if found != blank -%}
                  <input
                    type="radio"
                    class="duo-size-input"
                    name="{{ hero_id }}-rollon-size"
                    id="{{ hero_id }}-rollon-{{ size }}"
                    value="{{ found.id }}"
                    data-price="{{ found.price }}"
                    {% if forloop.first %}checked{% endif %}
                    {% unless found.available %}disabled{% endunless %}
                  >
                  <label class="duo-size-label" for="{{ hero_id }}-rollon-{{ size }}">{{ size }}</label>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>

          <div class="duo-card__breakdown duo-hero__price">
            <span class="duo-card__retail" data-duo-retail hidden></span>
            <span class="offer-card__price" data-duo-price></span>
          </div>

          {%- comment -%}
            Inline "Add to cart", matching a real product page's own buy
            button — the fixed offer-builder__bar below no longer shows
            immediately on page load (see its is-visible gating in
            component-duo-pairs.css / duo-pairs.js's observeBarTrigger); it
            only slides up once this button scrolls out of view, exactly
            like assets/product-sticky-bar.js does on every other product
            page. Without a real button here, hiding the bar at load would
            leave no way to buy at all.
          {%- endcomment -%}
          <button type="button" class="button button--primary duo-hero__add" data-duo-add-inline>
            <span data-duo-add-inline-label>{{ section.settings.button_label | default: 'Add duo to cart' }}</span>
            {% render 'loading-spinner' %}
          </button>

          {%- if hero_gift_eligible -%}
            {%- comment -%}
              Optional, not required — skipping just leaves the slot
              unclaimed, reappearing in the cart's own free-gift-picker
              exactly as if this duo picker didn't exist. Which variant id
              actually gets added (10ml vs 35ml) is resolved at add-to-cart
              time by duo-pairs.js, from whichever Perfume size chip is
              checked at that moment — not fixed to this size's default.
            {%- endcomment -%}
            <div class="product-gift-picker duo-gift-picker" data-duo-gift-picker>
              <p class="product-gift-picker__heading">
                {{- settings.free_gift_heading | default: 'Your free perfume' -}}
              </p>
              <p class="product-gift-picker__subtext">
                {{- settings.free_gift_subtext | default: 'Pick one on us — no code needed.' -}}
              </p>
              <div class="product-gift-picker__select-wrap">
                <select class="product-gift-picker__select" data-duo-gift-select aria-label="Choose your free perfume">
                  <option value="" selected>Skip for now</option>
                  {%- liquid
                    assign gift_slot = 0
                  -%}
                  {%- for gift in gift_source_collection.products -%}
                    {%- liquid
                      assign gift_title_lower = gift.title | downcase
                      if gift_title_lower contains 'customize'
                        continue
                      endif
                    -%}
                    {%- assign gift_variant_small = blank -%}
                    {%- assign gift_variant_large = blank -%}
                    {%- for v in gift.variants -%}
                      {%- if v.option1 == '10ML' -%}
                        {%- assign gift_variant_small = v -%}
                      {%- elsif v.option1 == '35ML' -%}
                        {%- assign gift_variant_large = v -%}
                      {%- endif -%}
                    {%- endfor -%}
                    {%- if gift_variant_small == blank and gift_variant_large == blank -%}
                      {%- continue -%}
                    {%- endif -%}
                    {%- assign gift_slot = gift_slot | plus: 1 -%}
                    {%- if gift_slot > 12 -%}
                      {%- break -%}
                    {%- endif -%}
                    <option
                      value="{{ gift.id }}"
                      data-gift-variant-small="{{ gift_variant_small.id }}"
                      data-gift-variant-large="{{ gift_variant_large.id }}"
                    >
                      {{- gift.title | escape -}}
                    </option>
                  {%- endfor -%}
                </select>
              </div>
              <p class="product-gift-picker__confirm" data-duo-gift-confirm hidden></p>
            </div>
          {%- endif -%}

          {%- if section.settings.perks != blank -%}
            <ul class="offer-builder__perks duo-hero__perks">
              {%- for perk in perks -%}
                {%- if perk != blank -%}
                  <li>
                    {% render 'icon-checkmark' %}
                    <span>{{ perk | strip }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- comment -%}
    Synchronous, non-deferred: resolves grid-vs-hero visibility (and the
    sticky bar) before first paint, using the same ?duo=<handle> match
    duo-pairs.js's setupHeroView() does. Without this, both views render
    from their server-rendered defaults — grid visible, hero hidden — until
    the deferred duo-pairs.js finishes loading and swaps them, so every
    visit to a single-duo link (?duo=...) flashed the "browse all 6" grid
    first. That flash was reported as "the entrance animation isn't
    playing" — not surprising, since a page-content swap mid-load reads as
    broken, not as a missing fade. duo-pairs.js still runs its own
    setupHeroView() afterward for the rest of its setup (selectCard,
    pricing, galleries); this script only prevents the flash, and setting
    the same hidden/visible state twice is harmless.
  {%- endcomment -%}
  <script>
    (function () {
      var root = document.currentScript.closest('duo-pairs');
      if (!root) return;
      var duoParam = new URLSearchParams(window.location.search).get('duo');
      var heroes = root.querySelectorAll('[data-duo-hero]');
      var match = null;
      if (duoParam) {
        for (var i = 0; i < heroes.length; i++) {
          if (heroes[i].getAttribute('data-bundle-handle') === duoParam) {
            match = heroes[i];
            break;
          }
        }
      }
      var bar = root.querySelector('[data-offer-bar]');
      if (bar) bar.hidden = !match;
      if (!match) return;
      var grid = root.querySelector('[data-duo-grid-view]');
      var heroView = root.querySelector('[data-duo-hero-view]');
      if (grid) grid.hidden = true;
      if (heroView) heroView.hidden = false;
      heroes.forEach(function (card) {
        card.hidden = card !== match;
      });
    })();
  </script>

  <div class="offer-builder__bar" data-offer-bar>
    <div class="offer-builder__bar-track" aria-hidden="true">
      <span class="offer-builder__bar-fill"></span>
    </div>

    <div class="offer-builder__bar-inner page-width">
      <div class="offer-builder__bar-summary">
        <div class="offer-builder__bar-progress">
          <span class="offer-builder__bar-count" data-duo-selected-name>—</span>
          <span class="offer-builder__bar-label">selected duo</span>
        </div>
        <p class="offer-builder__bar-picks" data-duo-picks></p>
      </div>

      <div class="offer-builder__bar-cta">
        <div class="offer-builder__bar-pricing">
          <span class="offer-builder__bar-price" data-duo-bar-price>Select a duo</span>
          <span class="offer-builder__bar-worth" data-duo-worth hidden></span>
        </div>
        <button type="button" class="offer-builder__bar-add" data-duo-add disabled>
          <span data-duo-add-label>{{ section.settings.button_label | default: 'Add duo to cart' }}</span>
          {% render 'loading-spinner' %}
        </button>
      </div>
    </div>
    <p class="offer-builder__bar-error" data-duo-error hidden role="alert"></p>
  </div>
</duo-pairs>

{% schema %}
{
  "name": "Duo Pairs",
  "tag": "section",
  "class": "section section--duo-pairs",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "One card per signature-series fragrance, each pairing that fragrance's own perfume with its own attar roll-on (matched automatically by title — nothing to configure per fragrance). The customer only changes each item's size; add a new fragrance to the perfume collection below and, once it has a matching roll-on, a card appears for it automatically."
    },
    {
      "type": "collection",
      "id": "perfume_collection",
      "label": "Perfume collection",
      "info": "Defaults to the free-gift qualifying collection (Theme settings → Free gift), which itself defaults to \"signature-series\"."
    },
    {
      "type": "product",
      "id": "all_duos_product",
      "label": "\"Browse all duos\" product",
      "info": "Where the \"All Signature Duos\" back link (shown on a single fragrance's page) goes. Defaults to the product with handle \"signature-duo\" if left blank. Always opened with ?view=duo forced, so it shows this grid regardless of that product's own Theme template."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Signature Duos"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge text",
      "info": "Leave blank to auto-generate from the discount below."
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Your signature scent, in perfume and attar — pick your sizes below."
    },
    {
      "type": "textarea",
      "id": "perks",
      "label": "Perks (one per line)",
      "default": "Free shipping on duos\nMix any sizes you like"
    },
    {
      "type": "header",
      "content": "Discount"
    },
    {
      "type": "select",
      "id": "discount_type",
      "options": [
        { "value": "none", "label": "No discount" },
        { "value": "fixed", "label": "Fixed amount off (₹)" },
        { "value": "percent", "label": "Percentage off (%)" }
      ],
      "default": "percent",
      "label": "Discount type"
    },
    {
      "type": "number",
      "id": "discount_amount",
      "label": "Discount amount",
      "default": 20,
      "info": "In ₹ for \"Fixed amount off\", in % for \"Percentage off\". Applied to the retail total of the chosen perfume size + roll-on size, computed live."
    },
    {
      "type": "header",
      "content": "Labels"
    },
    {
      "type": "text",
      "id": "select_label",
      "label": "Card select button",
      "default": "Select this duo"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Add to cart button",
      "default": "Add duo to cart"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        { "value": "scheme-1", "label": "Scheme 1" },
        { "value": "scheme-2", "label": "Scheme 2" },
        { "value": "scheme-3", "label": "Scheme 3" },
        { "value": "scheme-4", "label": "Scheme 4" }
      ],
      "default": "scheme-1",
      "label": "Color scheme"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Duo Pairs"
    }
  ]
}
{% endschema %}
