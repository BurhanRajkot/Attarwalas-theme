{%- liquid
  assign social_icons = true
  if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
    assign social_icons = false
  endif
  if section.settings.enable_country_selector or section.settings.enable_language_selector
    assign language_country_selector = true
  endif
  if section.blocks.size > 0
    assign announcement_bar = true
  endif

  comment
    News-ticker style continuous scroll, replacing Dawn's stock one-at-a-time
    slideshow (prev/next arrows, cross-fade between messages). Duration scales
    with block count so the ticker's visual speed — not the time per loop —
    stays roughly constant however many announcements are added; change_slides_speed
    (seconds, still the same customizer control) is "seconds per message" here
    rather than "seconds this message is shown before the next slides in".
  endcomment
  assign marquee_duration = section.settings.change_slides_speed | times: section.blocks.size
-%}

{%- if section.blocks.size > 0 -%}
  {%- style -%}
    /* .announcement-bar keeps Dawn's base.css rule (grid-area: announcements,
       flex centering) — this only adds the marquee behaviour on top, scoped
       to the modifier class so it can't affect anything else using
       .announcement-bar's base styling. */
    .announcement-bar--marquee {
      overflow: hidden;
      justify-content: flex-start;
    }

    .announcement-bar__track {
      display: flex;
      width: max-content;
      animation: announcement-bar-scroll-{{ section.id }} var(--marquee-duration, 20s) linear infinite;
    }

    @keyframes announcement-bar-scroll-{{ section.id }} {
      from {
        transform: translateX(0);
      }
      to {
        /* exactly one of the two identical .announcement-bar__set copies —
           see the comment in the markup for why this is seamless */
        transform: translateX(-50%);
      }
    }

    /* Pausable on hover/focus — WCAG 2.2.2 requires a way to stop
       auto-moving content that runs longer than 5s, and it also means a
       customer can actually read or click a message instead of chasing it. */
    .announcement-bar--marquee:hover .announcement-bar__track,
    .announcement-bar--marquee:focus-within .announcement-bar__track {
      animation-play-state: paused;
    }

    .announcement-bar__set {
      display: flex;
      flex-shrink: 0;
    }

    /* Typography otherwise comes from the .h5 class on this element, same as
       Dawn's stock bar used (<p class="announcement-bar__message h5">) — but
       .h5's own font-weight (600) reads thinner than this bar had before the
       marquee rewrite: base.css's older ".announcement-bar__message,
       .announcement-bar__message span { font-weight: 700 !important }" rule
       (still in base.css, now orphaned — it targets classes this markup no
       longer uses) is why every message here, and its link text, should be
       one single weight rather than drifting back to .h5's default. */
    .announcement-bar__item,
    .announcement-bar__item * {
      font-weight: 700;
    }

    .announcement-bar__item {
      display: inline-flex;
      align-items: center;
      flex-shrink: 0;
      white-space: nowrap;
      padding: 1.4rem 2.4rem;
    }

    /* A small muted dot between every item, including the last of each
       set — that's what makes the set-1-to-set-2 join in the loop read as
       one continuous sequence instead of a visible seam. Was a gold diamond;
       toned down 2026-09-13 because the ornament read as template decoration. */
    .announcement-bar__item:after {
      content: '';
      display: inline-block;
      width: 0.4rem;
      height: 0.4rem;
      margin-left: 2.4rem;
      flex-shrink: 0;
      border-radius: 50%;
      background: rgba(var(--color-foreground), 0.35);
    }

    .announcement-bar__link {
      display: inline-flex;
      align-items: center;
      white-space: nowrap;
      text-decoration: none;
    }

    .announcement-bar__link:hover {
      text-decoration: underline;
    }

    .announcement-bar__link .icon-arrow {
      display: inline-block;
      width: 1.2rem;
      margin-left: 0.8rem;
    }

    @media (prefers-reduced-motion: reduce) {
      .announcement-bar__track {
        animation: none;
      }

      /* Without the animation there's nothing to loop, so the duplicate
         copy would otherwise just sit there rendering the same text twice. */
      .announcement-bar__set[aria-hidden='true'] {
        display: none;
      }
    }
  {%- endstyle -%}
{%- endif -%}

{% if social_icons %}
  {{ 'component-list-social.css' | asset_url | stylesheet_tag }}
{% endif %}

<div
  class="utility-bar color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator and section.blocks.size > 0 %} utility-bar--bottom-border{% elsif section.settings.show_line_separator and section.settings.show_social and social_icons%} utility-bar--bottom-border-social-only{% endif %}{% if section.settings.enable_country_selector or section.settings.enable_language_selector %} header-localization{% endif %}"
  {{ block.shopify_attributes }}
>
  <div class="page-width utility-bar__grid{% if announcement_bar and language_country_selector or section.settings.show_social and social_icons %} utility-bar__grid--3-col{% elsif language_country_selector or section.settings.show_social and social_icons %} utility-bar__grid--2-col{% endif %}">
    {%- if section.settings.show_social and social_icons -%}
      {%- render 'social-icons' -%}
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <div
        class="announcement-bar announcement-bar--marquee"
        role="region"
        aria-label="{{ 'sections.header.announcement' | t }}"
        style="--marquee-duration: {{ marquee_duration }}s;"
      >
        <div class="announcement-bar__track">
          {%- comment -%}
            Two identical copies sit side by side; animating the track from
            translateX(0) to translateX(-50%) scrolls exactly one copy's width
            off-screen, so the loop point is invisible — the second copy is
            already sitting where the first one started. The second copy is
            aria-hidden so screen readers hear each message once, not twice.
          {%- endcomment -%}
          {%- for pass in (1..2) -%}
            <div class="announcement-bar__set" {% unless forloop.first %}aria-hidden="true"{% endunless %}>
              {%- for block in section.blocks -%}
                {%- if block.settings.text != blank -%}
                  <span
                    class="announcement-bar__item h5"
                    {% if forloop.parentloop.first %}{{ block.shopify_attributes }}{% endif %}
                  >
                    {%- if block.settings.link != blank -%}
                      <a href="{{ block.settings.link }}" class="announcement-bar__link link link--text animate-arrow">
                        <span>{{ block.settings.text | escape }}</span>
                        {% render 'icon-arrow' %}
                      </a>
                    {%- else -%}
                      <span>{{ block.settings.text | escape }}</span>
                    {%- endif -%}
                  </span>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
    <div class="localization-wrapper">
      {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
        <localization-form class="small-hide medium-hide">
          {%- form 'localization', id: 'AnnouncementCountryForm', class: 'localization-form' -%}
            <div>
              <h2 class="visually-hidden" id="AnnouncementCountryLabel">{{ 'localization.country_label' | t }}</h2>
              {%- render 'country-localization', localPosition: 'AnnouncementCountry' -%}
            </div>
          {%- endform -%}
        </localization-form>
      {% endif %}

      {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
        <localization-form class="small-hide medium-hide">
          {%- form 'localization', id: 'AnnouncementLanguageForm', class: 'localization-form' -%}
            <div>
              <h2 class="visually-hidden" id="AnnouncementLanguageLabel">{{ 'localization.language_label' | t }}</h2>
              {%- render 'language-localization', localPosition: 'AnnouncementLanguage' -%}
            </div>
          {%- endform -%}
        </localization-form>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "max_blocks": 12,
  "class": "announcement-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "checkbox",
      "id": "show_line_separator",
      "default": true,
      "label": "t:sections.header.settings.show_line_separator.label"
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.header__1.content",
      "info": "t:sections.announcement-bar.settings.header__1.info"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": false,
      "label": "t:sections.announcement-bar.settings.show_social.label"
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.header__2.content"
    },
    {
      "type": "paragraph",
      "content": "The bar now scrolls continuously (a news-ticker style marquee) rather than showing one message at a time, so there's no on/off for that — only how fast it scrolls."
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "t:sections.announcement-bar.settings.change_slides_speed.label",
      "info": "Seconds per message — the ticker's total loop time is this multiplied by however many announcement blocks are added, so the scroll speed stays about the same either way.",
      "default": 5
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.header__3.content",
      "info": "t:sections.announcement-bar.settings.header__3.info"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": false,
      "label": "t:sections.announcement-bar.settings.enable_country_selector.label"
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.header__4.content",
      "info": "t:sections.announcement-bar.settings.header__4.info"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "default": false,
      "label": "t:sections.announcement-bar.settings.enable_language_selector.label"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement-bar.blocks.announcement.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "Welcome to our store",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.text.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement-bar.presets.name",
      "blocks": [
        {
          "type": "announcement"
        }
      ]
    }
  ]
}
{% endschema %}
