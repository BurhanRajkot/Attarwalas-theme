{{ 'section-customer-reviews.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #CustomerReviews-{{ section.id }} .customer-reviews__grid {
    --reviews-columns-desktop: {{ section.settings.columns_desktop }};
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient customer-reviews-wrapper">
  <div
    id="CustomerReviews-{{ section.id }}"
    class="{% if section.settings.full_width %}customer-reviews--full-width{% else %}page-width{% endif %} section-{{ section.id }}-padding"
  >
    {%- if section.settings.title != blank -%}
      <div class="customer-reviews__title-row" data-reviews-header>
        <span class="customer-reviews__line" aria-hidden="true"></span>
        <h2 class="customer-reviews__heading">{{ section.settings.title }}</h2>
        <span class="customer-reviews__line" aria-hidden="true"></span>
      </div>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="customer-reviews__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- if section.blocks.size == 0 -%}
      <p class="customer-reviews__empty">Add video blocks in the section settings to feature customer reviews.</p>
    {%- else -%}
      <div class="customer-reviews__carousel">
        <div class="customer-reviews__grid" id="CustomerReviewsTrack-{{ section.id }}">
          {%- for block in section.blocks -%}
            {%- assign featured_product = blank -%}
            {%- if block.settings.product != blank -%}
              {%- assign featured_product = block.settings.product -%}
            {%- endif -%}
            {%- comment -%}
              The 10ML/35ML variants on signature-series products exist only
              to back the free-gift pickers, priced far below the real sizes
              (see snippets/price.liquid's identical comment) — Shopify's own
              product.price / selected_or_first_available_variant pick the
              cheapest/first variant regardless, which is one of those two.
              That's what showed "Rs. 300" here for Ambre Intense instead of
              its real price, and would have added that gift-size variant to
              the cart via Add to Cart/Buy Now. Recomputed the same way price
              .liquid does, scoped to the qualifying collection so roll-ons
              (which have real, purchasable 10ML/35ML sizes) are unaffected.
            {%- endcomment -%}
            {%- assign featured_variant = featured_product.selected_or_first_available_variant -%}
            {%- assign hide_gift_only_sizes = false -%}
            {%- if featured_product != blank and settings.free_gift_enabled -%}
              {%- assign qualifying_collection = settings.free_gift_qualifying_collection -%}
              {%- if qualifying_collection == blank -%}
                {%- assign qualifying_collection = collections['signature-series'] -%}
              {%- endif -%}
              {%- for c in featured_product.collections -%}
                {%- if c.handle == qualifying_collection.handle -%}
                  {%- assign hide_gift_only_sizes = true -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
            {%- assign is_gift_only_variant = false -%}
            {%- if featured_variant.option1 == '10ML' or featured_variant.option1 == '35ML' -%}
              {%- assign is_gift_only_variant = true -%}
            {%- endif -%}
            {%- if hide_gift_only_sizes and is_gift_only_variant -%}
              {%- assign real_variant = null -%}
              {%- for variant in featured_product.variants -%}
                {%- unless variant.option1 == '10ML' or variant.option1 == '35ML' -%}
                  {%- if real_variant == null or variant.available -%}
                    {%- assign real_variant = variant -%}
                    {%- if variant.available -%}
                      {%- break -%}
                    {%- endif -%}
                  {%- endif -%}
                {%- endunless -%}
              {%- endfor -%}
              {%- if real_variant != null -%}
                {%- assign featured_variant = real_variant -%}
              {%- endif -%}
            {%- endif -%}
            <button
              type="button"
              class="customer-reviews__card"
              data-reviews-card
              data-index="{{ forloop.index0 }}"
              data-review-open
              data-name="{{ block.settings.customer_name | default: 'Happy Customer' | escape }}"
              data-product-url="{{ featured_product.url | default: '' | escape }}"
              data-product-title="{{ featured_product.title | default: '' | escape }}"
              data-product-price="{{ featured_variant.price | money | default: '' | escape }}"
              data-product-image="{{ featured_product.featured_image | image_url: width: 300 | default: '' }}"
              data-variant-id="{{ featured_variant.id | default: '' }}"
              data-available="{{ featured_variant.available | default: false }}"
              data-note-1="{{ block.settings.note_1 | default: '' | escape }}"
              data-note-2="{{ block.settings.note_2 | default: '' | escape }}"
              data-note-3="{{ block.settings.note_3 | default: '' | escape }}"
              {{ block.shopify_attributes }}
            >
              <div class="customer-reviews__video-wrap">
                {%- if block.settings.video != blank -%}
                  <video
                    class="customer-reviews__video"
                    data-reviews-video
                    muted
                    loop
                    playsinline
                    preload="none"
                    {%- if block.settings.video.preview_image -%}
                      data-poster="{{ block.settings.video.preview_image | image_url: width: 700 }}"
                    {%- endif -%}
                  >
                    {%- comment -%}
                      data-src, not src: the script below swaps these in when the
                      card nears the screen. These are 1080p MP4s of 15–33 MB
                      each; with plain src every one was fetched with the page
                      (crawlers measured the homepage at ~44 MB). The poster
                      stands in until then.

                      The poster is data-poster for the same reason: a <video>
                      poster never lazy-loads, so all eight (~600 KB) downloaded
                      with the page, competing with the hero image for bandwidth
                      far above this section. The 9:16 wrap holds the space
                      meanwhile.

                      Both go live for every card as soon as the page has loaded
                      (or earlier, if the section is scrolled near first), so by
                      the time anyone reaches the strip each video has its first
                      frames and starts playing on its own. Hydrating only on
                      approach was tried and was too late on phones: cards sat on
                      a still poster while 1080p video buffered (2026-10-02).
                    {%- endcomment -%}
                    {%- for source in block.settings.video.sources -%}
                      <source data-src="{{ source.url }}" type="{{ source.mime_type }}">
                    {%- endfor -%}
                  </video>

                  <span
                    class="customer-reviews__mute-toggle"
                    role="button"
                    tabindex="0"
                    data-mute-toggle
                    aria-label="Unmute video"
                    aria-pressed="false"
                  >
                    <svg class="icon-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="4 9 8 9 12 5 12 19 8 15 4 15 4 9"></polygon>
                      <line x1="16" y1="9" x2="21" y2="14"></line>
                      <line x1="21" y1="9" x2="16" y2="14"></line>
                    </svg>
                    <svg class="icon-unmuted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="4 9 8 9 12 5 12 19 8 15 4 15 4 9"></polygon>
                      <path d="M16 8.5a4.5 4.5 0 0 1 0 7"></path>
                      <path d="M18.5 6a8 8 0 0 1 0 12"></path>
                    </svg>
                  </span>

                  {%- if block.settings.customer_name != blank -%}
                    <span class="customer-reviews__video-caption">{{ block.settings.customer_name }}</span>
                  {%- endif -%}
                {%- else -%}
                  <div class="customer-reviews__video-placeholder">
                    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="2" y="5" width="14" height="14" rx="2"></rect>
                      <polygon points="16 10 22 7 22 17 16 14 16 10"></polygon>
                    </svg>
                    <span>Customer video coming soon</span>
                  </div>
                {%- endif -%}
              </div>

              {%- if featured_product != blank -%}
                <span class="customer-reviews__product">
                  {%- if featured_product.featured_image != blank -%}
                    <img
                      src="{{ featured_product.featured_image | image_url: width: 300 }}"
                      alt="{{ featured_product.featured_image.alt | default: featured_product.title | escape }}"
                      width="96"
                      height="96"
                      loading="lazy"
                      class="customer-reviews__product-image"
                    >
                  {%- endif -%}
                </span>
              {%- endif -%}
            </button>
          {%- endfor -%}
        </div>
        <div class="customer-reviews__scrollbar" data-reviews-scrollbar hidden aria-hidden="true">
          <span class="customer-reviews__scrollbar-thumb" data-reviews-thumb></span>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{%- comment -%} Review popup: plays the customer video with the product and purchase options {%- endcomment -%}
<div class="customer-reviews__modal" data-reviews-modal aria-hidden="true">
  <div class="customer-reviews__modal-overlay" data-modal-close></div>
  <div
    class="customer-reviews__modal-dialog"
    role="dialog"
    aria-modal="true"
    aria-label="Customer video review"
  >
    <button type="button" class="customer-reviews__modal-close" data-modal-close aria-label="Close review">
      {% render 'icon-close' %}
    </button>

    <div class="customer-reviews__modal-media" data-modal-media></div>

    <div class="customer-reviews__modal-content">
      <div class="customer-reviews__modal-product-head" data-modal-product>
        <a class="customer-reviews__modal-product-link" data-modal-product-link aria-label="View product details" href="#">
          {%- comment -%}
            No `src` attribute at all until JS fills it in below. `src=""`
            resolves to the current page URL, so every page load fired a
            second request for the whole document and left a broken image in
            the modal until a review was opened.
          {%- endcomment -%}
          <img alt="Reviewed product" width="72" height="72" loading="lazy" class="customer-reviews__modal-product-image" data-modal-product-image>
          <span class="customer-reviews__modal-product-info">
            <span class="customer-reviews__modal-product-title" data-modal-product-title></span>
            <span class="customer-reviews__modal-product-price" data-modal-product-price></span>
          </span>
        </a>
      </div>

      <div class="customer-reviews__modal-notes" data-modal-notes hidden>
        <p class="customer-reviews__modal-notes-label">Fragrance Notes</p>
        <div class="customer-reviews__modal-notes-list">
          <span class="customer-reviews__modal-note" data-modal-note-1></span>
          <span class="customer-reviews__modal-note" data-modal-note-2></span>
          <span class="customer-reviews__modal-note" data-modal-note-3></span>
        </div>
      </div>

      <product-form class="customer-reviews__product-form" data-section-id="{{ section.id }}">
        <form method="post" action="{{ routes.cart_add_url }}" class="customer-reviews__form form" data-type="add-to-cart-form">
          <input type="hidden" name="form_type" value="product">
          <input type="hidden" name="utf8" value="✓">
          <input type="hidden" name="id" value="" data-modal-variant-id>

          <div class="product-form__error-message-wrapper customer-reviews__error" role="alert" hidden>
            <svg aria-hidden="true" focusable="false" class="icon icon-error" viewBox="0 0 13 13">
              <circle cx="6.5" cy="6.50049" r="5.5" stroke="white" stroke-width="2"></circle>
              <circle cx="6.5" cy="6.5" r="5.5" fill="#EB001B" stroke="#EB001B" stroke-width="0.7"></circle>
              <path d="M5.87413 3.52832L5.97439 7.57216H7.02713L7.12739 3.52832H5.87413ZM6.50076 9.66091C6.88091 9.66091 7.18169 9.37267 7.18169 9.00504C7.18169 8.63742 6.88091 8.34917 6.50076 8.34917C6.12061 8.34917 5.81982 8.63742 5.81982 9.00504C5.81982 9.37267 6.12061 9.66091 6.50076 9.66091Z" fill="white"></path>
              <path d="M5.87413 3.17832H5.51535L5.52424 3.537L5.6245 7.58083L5.63296 7.92216H5.97439H7.02713H7.36856L7.37702 7.58083L7.47728 3.537L7.48617 3.17832H7.12739H5.87413ZM6.50076 10.0109C7.06121 10.0109 7.5317 9.57872 7.5317 9.00504C7.5317 8.43137 7.06121 7.99918 6.50076 7.99918C5.94031 7.99918 5.46982 8.43137 5.46982 9.00504C5.46982 9.57872 5.94031 10.0109 6.50076 10.0109Z" fill="white" stroke="#EB001B" stroke-width="0.7"></path>
            </svg>
            <span class="product-form__error-message"></span>
          </div>

          <div class="customer-reviews__buy-row">
            <button
              id="CustomerReviewsSubmit-{{ section.id }}"
              type="submit"
              name="add"
              class="button customer-reviews__add-button"
            >
              <span>{{ 'products.product.add_to_cart' | t }}</span>
              {%- render 'loading-spinner' -%}
            </button>
            <button
              type="button"
              name="buy"
              class="button button--secondary customer-reviews__buy-button"
              data-buy-now
            >
              Buy Now
            </button>
          </div>

          <p class="customer-reviews__view-details">
            <a href="#" data-modal-product-link data-modal-details-link>View full details</a>
          </p>
        </form>
      </product-form>
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('CustomerReviews-{{ section.id }}');
    if (!root) return;
    var track = root.querySelector('.customer-reviews__grid');
    var bar = root.querySelector('[data-reviews-scrollbar]');
    var thumb = root.querySelector('[data-reviews-thumb]');
    if (!track || !bar || !thumb) return;

    // Draggable scrollbar under the row (desktop / mouse). Hidden by CSS below 750px.
    function update() {
      var max = track.scrollWidth - track.clientWidth;
      if (max <= 2) { bar.hidden = true; return; }
      bar.hidden = false;
      var ratio = track.clientWidth / track.scrollWidth;
      var thumbW = Math.max(ratio * bar.clientWidth, 48);
      thumb.style.width = thumbW + 'px';
      thumb.style.transform = 'translateX(' + (track.scrollLeft / max) * (bar.clientWidth - thumbW) + 'px)';
    }
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    window.addEventListener('load', update);
    // A frame later, not mid-parse, where it forced a layout of the page so far.
    requestAnimationFrame(update);

    function noSmooth(on) { track.style.scrollBehavior = on ? 'auto' : ''; }

    // Click-and-drag the cards themselves with a mouse.
    var dragging = false, moved = false, startX = 0, startLeft = 0;
    track.addEventListener('pointerdown', function (e) {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      dragging = true; moved = false; startX = e.clientX; startLeft = track.scrollLeft;
    });
    window.addEventListener('pointermove', function (e) {
      if (!dragging) return;
      var dx = e.clientX - startX;
      if (!moved && Math.abs(dx) > 5) { moved = true; noSmooth(true); track.classList.add('is-dragging'); }
      if (moved) track.scrollLeft = startLeft - dx;
    });
    function endDrag() {
      if (!dragging) return;
      dragging = false; noSmooth(false); track.classList.remove('is-dragging');
    }
    window.addEventListener('pointerup', endDrag);
    window.addEventListener('pointercancel', endDrag);
    // A drag must not count as a click on the card underneath (it opens the popup).
    track.addEventListener('click', function (e) {
      if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; }
    }, true);
    track.addEventListener('dragstart', function (e) { e.preventDefault(); });

    // Drag the thumb, or click the rail to jump.
    var thumbDrag = false, tStartX = 0, tStartLeft = 0;
    thumb.addEventListener('pointerdown', function (e) {
      thumbDrag = true; tStartX = e.clientX; tStartLeft = track.scrollLeft;
      noSmooth(true); thumb.setPointerCapture(e.pointerId); e.preventDefault(); e.stopPropagation();
    });
    thumb.addEventListener('pointermove', function (e) {
      if (!thumbDrag) return;
      var travel = bar.clientWidth - thumb.offsetWidth;
      var max = track.scrollWidth - track.clientWidth;
      if (travel > 0) track.scrollLeft = tStartLeft + ((e.clientX - tStartX) / travel) * max;
    });
    function endThumb() { thumbDrag = false; noSmooth(false); }
    thumb.addEventListener('pointerup', endThumb);
    thumb.addEventListener('pointercancel', endThumb);
    bar.addEventListener('pointerdown', function (e) {
      if (e.target !== bar) return;
      var rect = bar.getBoundingClientRect();
      var frac = (e.clientX - rect.left - thumb.offsetWidth / 2) / (bar.clientWidth - thumb.offsetWidth);
      track.scrollTo({ left: Math.min(Math.max(frac, 0), 1) * (track.scrollWidth - track.clientWidth), behavior: 'smooth' });
    });
  })();
</script>

<script>
  (function () {
    var section = document.getElementById('CustomerReviews-{{ section.id }}');
    if (!section) return;

    var header = section.querySelector('[data-reviews-header]');
    var cards = Array.from(section.querySelectorAll('[data-reviews-card]'));
    var revealTargets = header ? [header].concat(cards) : cards;
    var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (revealTargets.length) {
      if (!('IntersectionObserver' in window) || reducedMotion) {
        revealTargets.forEach(function (el) {
          el.classList.add(el === header ? 'customer-reviews__title-row--visible' : 'customer-reviews__card--visible');
        });
      } else {
        var revealObserver = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              var el = entry.target;
              if (el === header) {
                el.classList.add('customer-reviews__title-row--visible');
              } else {
                var index = parseInt(el.dataset.index, 10) || 0;
                el.style.transitionDelay = (index % 3) * 100 + 'ms';
                el.classList.add('customer-reviews__card--visible');
              }
              revealObserver.unobserve(el);
            });
          },
          { threshold: 0, rootMargin: '0px 0px -6% 0px' }
        );

        revealTargets.forEach(function (el) {
          revealObserver.observe(el);
        });
      }
    }

    /* ---------- Lazy posters (see the comment on the markup) ---------- */
    var videos = Array.from(section.querySelectorAll('[data-reviews-video]'));
    var showPoster = function (video) {
      if (!video.dataset.poster) return;
      video.poster = video.dataset.poster;
      video.removeAttribute('data-poster');
    };
    if ('IntersectionObserver' in window) {
      var posterObserver = new IntersectionObserver(
        function (entries) {
          if (!entries.some(function (entry) { return entry.isIntersecting; })) return;
          videos.forEach(showPoster);
          posterObserver.disconnect();
        },
        { rootMargin: '900px 0px' }
      );
      posterObserver.observe(section);
    } else {
      videos.forEach(showPoster);
    }

    /* ---------- Video sources (see the comment on the markup) ---------- */
    var hydrateVideo = function (video) {
      if (!video || video.dataset.hydrated) return;
      video.dataset.hydrated = 'true';
      showPoster(video);
      video.querySelectorAll('source[data-src]').forEach(function (source) {
        source.src = source.dataset.src;
        source.removeAttribute('data-src');
      });
      video.preload = 'metadata';
      video.load();
    };
    if ('IntersectionObserver' in window) {
      var hydrateObserver = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            hydrateVideo(entry.target);
            hydrateObserver.unobserve(entry.target);
          });
        },
        { rootMargin: '400px 400px' }
      );
      videos.forEach(function (video) {
        hydrateObserver.observe(video);
      });
    } else {
      videos.forEach(hydrateVideo);
    }

    var hydrateAll = function () {
      videos.forEach(showPoster);
      videos.forEach(hydrateVideo);
    };
    var afterLoad = function () {
      if ('requestIdleCallback' in window) {
        requestIdleCallback(hydrateAll, { timeout: 1500 });
      } else {
        setTimeout(hydrateAll, 200);
      }
    };
    if (document.readyState === 'complete') {
      afterLoad();
    } else {
      window.addEventListener('load', afterLoad, { once: true });
    }

    /* ---------- Mute toggles ---------- */
    videos.forEach(function (video) {
      var wrap = video.closest('.customer-reviews__video-wrap');
      var toggle = wrap ? wrap.querySelector('[data-mute-toggle]') : null;
      if (!toggle) return;

      var setMuted = function (muted) {
        video.muted = muted;
        toggle.setAttribute('aria-pressed', String(!muted));
        toggle.setAttribute('aria-label', muted ? 'Unmute video' : 'Mute video');
        wrap.classList.toggle('is-unmuted', !muted);
      };

      toggle.addEventListener('click', function () { setMuted(!video.muted); });
      toggle.addEventListener('keydown', function (event) {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          setMuted(!video.muted);
        }
      });
    });

    if (reducedMotion) {
      videos.forEach(function (video) {
        video.controls = true;
      });
    } else if ('IntersectionObserver' in window) {
      var videoObserver = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            var video = entry.target;
            if (entry.isIntersecting) {
              hydrateVideo(video);
              video.play().catch(function () {});
            } else {
              video.pause();
            }
          });
        },
        // A quarter visible is enough to play, so cards peeking in at the
        // edge of the strip move too instead of sitting still.
        { threshold: 0.25 }
      );

      videos.forEach(function (video) {
        videoObserver.observe(video);
      });
    } else {
      videos.forEach(function (video) {
        video.play().catch(function () {});
      });
    }

    /* ---------- Review popup ---------- */
    var modal = section.closest('section') ? section.closest('section').querySelector('[data-reviews-modal]') : null;
    if (!modal || !cards.length) return;

    var CHECKOUT_URL = {{ routes.checkout_url | default: shop.url | append: '/checkout' | json }};

    var media = modal.querySelector('[data-modal-media]');
    var productHead = modal.querySelector('[data-modal-product]');
    var productLinks = Array.from(modal.querySelectorAll('[data-modal-product-link]'));
    var productImage = modal.querySelector('[data-modal-product-image]');
    var productTitle = modal.querySelector('[data-modal-product-title]');
    var productPrice = modal.querySelector('[data-modal-product-price]');
    var notes = modal.querySelector('[data-modal-notes]');
    var noteEls = Array.from(modal.querySelectorAll('[data-modal-note-1], [data-modal-note-2], [data-modal-note-3]'));
    var variantInput = modal.querySelector('[data-modal-variant-id]');
    var form = modal.querySelector('form.customer-reviews__form');
    var errorWrapper = modal.querySelector('.customer-reviews__error');
    var errorMessage = modal.querySelector('.product-form__error-message');
    var addButton = modal.querySelector('.customer-reviews__add-button');
    var buyButton = modal.querySelector('[data-buy-now]');
    var closeButtons = modal.querySelectorAll('[data-modal-close]');
    var modalClose = modal.querySelector('.customer-reviews__modal-close');
    var lastFocused = null;
    var modalVideo = null;
    var currentAvailable = true;
    var historyPushed = false;

    var addButtonDefault = '{{ 'products.product.add_to_cart' | t | escape }}';

    var showError = function (message) {
      errorMessage.textContent = message || '';
      errorWrapper.hidden = !message;
    };

    var openModal = function (card) {
      var src = card.querySelector('video[data-reviews-video]');

      media.innerHTML = '';
      if (src) {
        hydrateVideo(src);
        var clone = src.cloneNode(true);
        clone.removeAttribute('autoplay');
        clone.removeAttribute('muted');
        clone.muted = false;
        if (reducedMotion) clone.controls = true;
        modalVideo = clone;
        media.classList.add('is-video');
        media.classList.remove('is-image');
        media.appendChild(clone);
        clone.play().catch(function () {
          clone.muted = true;
          clone.play().catch(function () {});
        });
      } else if (card.dataset.productImage) {
        media.classList.remove('is-video');
        media.classList.add('is-image');
        var img = document.createElement('img');
        img.src = card.dataset.productImage;
        img.alt = card.dataset.productTitle || 'Reviewed product';
        img.loading = 'lazy';
        media.appendChild(img);
      } else {
        media.classList.remove('is-video', 'is-image');
        media.innerHTML = '<span class="customer-reviews__modal-media-placeholder">' + card.dataset.productTitle + ' — customer video coming soon</span>';
      }

      var hasProduct = !!(card.dataset.variantId && card.dataset.productTitle);
      currentAvailable = card.dataset.available === 'true';

      if (hasProduct) {
        productLinks.forEach(function (link) {
          link.href = card.dataset.productUrl || '#';
        });
        productLinks[0].setAttribute('aria-label', 'View ' + card.dataset.productTitle + ' details');
        // Same reason as the markup above: never assign an empty src, or the
        // modal re-requests the page document and shows a broken image.
        if (card.dataset.productImage) {
          productImage.src = card.dataset.productImage;
        } else {
          productImage.removeAttribute('src');
        }
        productImage.alt = card.dataset.productTitle || 'Reviewed product';
        productTitle.textContent = card.dataset.productTitle || '';
        productPrice.textContent = card.dataset.productPrice || '';
      variantInput.value = card.dataset.variantId || '';
      productHead.hidden = false;
      form.hidden = false;
    } else {
      variantInput.value = '';
      productHead.hidden = true;
      form.hidden = true;
    }

    var currentNotes = [card.dataset.note1, card.dataset.note2, card.dataset.note3];
    noteEls.forEach(function (el, index) {
      var value = currentNotes[index] || '';
      el.textContent = value;
      el.hidden = !value;
    });
    notes.hidden = !currentNotes.some(function (value) { return value; });

      modal.classList.toggle('has-product', hasProduct);
      modal.classList.toggle('no-product', !hasProduct);
      showError();

      if (hasProduct) {
        if (currentAvailable) {
          addButton.disabled = false;
          addButton.querySelector('span').textContent = addButtonDefault;
          buyButton.disabled = false;
        } else {
          addButton.disabled = true;
          addButton.querySelector('span').textContent = '{{ 'products.product.sold_out' | t | escape }}';
          buyButton.disabled = true;
        }
      }

      lastFocused = card;
      modal.setAttribute('aria-hidden', 'false');
      modal.classList.add('is-open');
      document.body.classList.add('customer-reviews__modal-locked');
      if (modalClose) modalClose.focus();

      // Give the popup its own history entry so the phone's Back button /
      // back gesture closes it instead of leaving the page.
      if (!historyPushed) {
        try {
          history.pushState({ awReviewModal: true }, '');
          historyPushed = true;
        } catch (e) {}
      }
    };

    var closeModal = function (fromPopstate) {
      if (historyPushed) {
        historyPushed = false;
        if (fromPopstate !== true) history.back();
      }
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('customer-reviews__modal-locked');
      if (modalVideo) {
        modalVideo.pause();
        modalVideo = null;
      }
      media.innerHTML = '';
      if (lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus();
      lastFocused = null;
    };

    cards.forEach(function (card) {
      card.addEventListener('click', function (event) {
        event.preventDefault();
        if (event.target.closest('[data-mute-toggle]')) return;
        openModal(card);
      });
    });

    closeButtons.forEach(function (btn) {
      btn.addEventListener('click', function (event) {
        event.preventDefault();
        event.stopPropagation();
        closeModal();
      });
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && modal.classList.contains('is-open')) {
        closeModal();
      }
    });

    window.addEventListener('popstate', function () {
      if (modal.classList.contains('is-open')) {
        closeModal(true);
      } else {
        historyPushed = false;
      }
    });

    media.addEventListener('click', function () {
      if (modalVideo) {
        modalVideo.muted = !modalVideo.muted;
      }
    });

    /* Buy Now: add the item to the cart and continue to checkout */
    buyButton.addEventListener('click', function (event) {
      event.preventDefault();
      if (!variantInput || !variantInput.value || !currentAvailable) return;

      buyButton.setAttribute('aria-disabled', 'true');
      buyButton.classList.add('loading');

      var config = fetchConfig('javascript');
      config.headers['X-Requested-With'] = 'XMLHttpRequest';
      delete config.headers['Content-Type'];

      var formData = new FormData(form);
      config.body = formData;

      fetch(window.routes.cart_add_url, config)
        .then(function (response) { return response.json(); })
        .then(function (response) {
          if (response.status) {
            showError(response.description || response.message || 'Something went wrong. Please try again.');
            buyButton.removeAttribute('aria-disabled');
            buyButton.classList.remove('loading');
            return;
          }
          window.location.href = CHECKOUT_URL;
        })
        .catch(function () {
          showError('Something went wrong. Please try again.');
          buyButton.removeAttribute('aria-disabled');
          buyButton.classList.remove('loading');
        });
    });
  })();
</script>

