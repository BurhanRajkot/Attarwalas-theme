{{ 'section-customer-reviews.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #CustomerReviews-{{ section.id }} .customer-reviews__grid {
    --reviews-columns-desktop: {{ section.settings.columns_desktop }};
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient customer-reviews-wrapper">
  <div
    id="CustomerReviews-{{ section.id }}"
    class="{% if section.settings.full_width %}customer-reviews--full-width{% else %}page-width{% endif %} section-{{ section.id }}-padding"
  >
    {%- if section.settings.title != blank -%}
      <div class="customer-reviews__title-row" data-reviews-header>
        <span class="customer-reviews__line" aria-hidden="true"></span>
        <h2 class="customer-reviews__heading">{{ section.settings.title }}</h2>
        <span class="customer-reviews__line" aria-hidden="true"></span>
      </div>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="customer-reviews__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- if section.blocks.size == 0 -%}
      <p class="customer-reviews__empty">Add video blocks in the section settings to feature customer videos.</p>
    {%- else -%}
      <div class="customer-reviews__grid">
        {%- for block in section.blocks -%}
          <div class="customer-reviews__card" data-reviews-card data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <div class="customer-reviews__video-wrap">
              {%- if block.settings.video != blank -%}
                <video
                  class="customer-reviews__video"
                  data-reviews-video
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  {%- if block.settings.video.preview_image -%}
                    poster="{{ block.settings.video.preview_image | image_url: width: 700 }}"
                  {%- endif -%}
                >
                  {%- for source in block.settings.video.sources -%}
                    <source src="{{ source.url }}" type="{{ source.mime_type }}">
                  {%- endfor -%}
                </video>

                <button
                  type="button"
                  class="customer-reviews__mute-toggle"
                  data-mute-toggle
                  aria-label="Unmute video"
                  aria-pressed="false"
                >
                  <svg class="icon-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="4 9 8 9 12 5 12 19 8 15 4 15 4 9"></polygon>
                    <line x1="16" y1="9" x2="21" y2="14"></line>
                    <line x1="21" y1="9" x2="16" y2="14"></line>
                  </svg>
                  <svg class="icon-unmuted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="4 9 8 9 12 5 12 19 8 15 4 15 4 9"></polygon>
                    <path d="M16 8.5a4.5 4.5 0 0 1 0 7"></path>
                    <path d="M18.5 6a8 8 0 0 1 0 12"></path>
                  </svg>
                </button>

                {%- if block.settings.customer_name != blank -%}
                  <span class="customer-reviews__video-caption">{{ block.settings.customer_name }}</span>
                {%- endif -%}
              {%- else -%}
                <div class="customer-reviews__video-placeholder">Add a video in this block's settings</div>
              {%- endif -%}
            </div>

            {%- if block.settings.product != blank -%}
              {%- assign featured_product = block.settings.product -%}
              <a href="{{ featured_product.url }}" class="customer-reviews__product">
                {%- if featured_product.featured_image != blank -%}
                  <img
                    src="{{ featured_product.featured_image | image_url: width: 160 }}"
                    alt="{{ featured_product.featured_image.alt | default: featured_product.title | escape }}"
                    width="64"
                    height="64"
                    loading="lazy"
                    class="customer-reviews__product-image"
                  >
                {%- endif -%}
                <span class="customer-reviews__product-title">{{ featured_product.title }}</span>
                <span class="customer-reviews__product-price">{{ featured_product.price | money }}</span>
              </a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    var section = document.getElementById('CustomerReviews-{{ section.id }}');
    if (!section) return;

    var header = section.querySelector('[data-reviews-header]');
    var cards = Array.from(section.querySelectorAll('[data-reviews-card]'));
    var revealTargets = header ? [header].concat(cards) : cards;
    var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (revealTargets.length) {
      if (!('IntersectionObserver' in window) || reducedMotion) {
        revealTargets.forEach(function (el) {
          el.classList.add(el === header ? 'customer-reviews__title-row--visible' : 'customer-reviews__card--visible');
        });
      } else {
        var revealObserver = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              var el = entry.target;
              if (el === header) {
                el.classList.add('customer-reviews__title-row--visible');
              } else {
                var index = parseInt(el.dataset.index, 10) || 0;
                el.style.transitionDelay = (index % 3) * 100 + 'ms';
                el.classList.add('customer-reviews__card--visible');
              }
              revealObserver.unobserve(el);
            });
          },
          { threshold: 0.15, rootMargin: '0px 0px -60px 0px' }
        );

        revealTargets.forEach(function (el) {
          revealObserver.observe(el);
        });
      }
    }

    var videos = Array.from(section.querySelectorAll('[data-reviews-video]'));
    if (!videos.length) return;

    videos.forEach(function (video) {
      var wrap = video.closest('.customer-reviews__video-wrap');
      var toggle = wrap ? wrap.querySelector('[data-mute-toggle]') : null;
      if (!toggle) return;

      toggle.addEventListener('click', function () {
        video.muted = !video.muted;
        toggle.setAttribute('aria-pressed', String(!video.muted));
        toggle.setAttribute('aria-label', video.muted ? 'Unmute video' : 'Mute video');
        wrap.classList.toggle('is-unmuted', !video.muted);
      });
    });

    if (reducedMotion) {
      videos.forEach(function (video) {
        video.controls = true;
      });
      return;
    }

    if (!('IntersectionObserver' in window)) {
      videos.forEach(function (video) {
        video.play().catch(function () {});
      });
      return;
    }

    var videoObserver = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          var video = entry.target;
          if (entry.isIntersecting) {
            video.play().catch(function () {});
          } else {
            video.pause();
          }
        });
      },
      { threshold: 0.5 }
    );

    videos.forEach(function (video) {
      videoObserver.observe(video);
    });
  })();
</script>

{% schema %}
{
  "name": "Customer Reviews",
  "tag": "section",
  "class": "section section-customer-reviews",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "default": true,
      "label": "Make section full width"
    },
    {
      "type": "text",
      "id": "title",
      "default": "What Our Customers Say",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Desktop columns"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "video_review",
      "name": "Video review",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Customer video"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Featured product",
          "info": "Its image, title and price are shown below the video."
        },
        {
          "type": "text",
          "id": "customer_name",
          "label": "Customer name",
          "info": "Optional — shown as a caption over the video.",
          "default": "Happy Customer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer Reviews",
      "blocks": [
        {
          "type": "video_review",
          "settings": {
            "customer_name": "Aisha Khan"
          }
        },
        {
          "type": "video_review",
          "settings": {
            "customer_name": "Rohan Mehta"
          }
        },
        {
          "type": "video_review",
          "settings": {
            "customer_name": "Sara Ali"
          }
        }
      ]
    }
  ]
}
{% endschema %}
