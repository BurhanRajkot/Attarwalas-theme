{{ 'section-product-carousel.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient product-carousel-wrapper">
  <div class="{% if section.settings.full_width %}product-carousel--full-width{% else %}page-width{% endif %} section-{{ section.id }}-padding">
    {%- if section.settings.title != blank -%}
      <div class="product-carousel__title-row" data-carousel-header>
        <span class="product-carousel__line" aria-hidden="true"></span>
        <h2 class="product-carousel__heading">{{ section.settings.title }}</h2>
        <span class="product-carousel__line" aria-hidden="true"></span>
      </div>
    {%- endif -%}

    {%- liquid
      assign carousel_products = section.settings.products
      if carousel_products == blank or carousel_products.size == 0
        assign carousel_products = section.settings.collection.products
      endif

      comment
        Duo mode: each card is a real product that exists only to host a
        duo product page (sections/duo-pairs.liquid) — same idea as the
        "Signature Duos teaser" block on the product page
        (snippets/duo-teaser.liquid). Forces ?view=duo on every card's link
        so it opens correctly even before each product's own Theme template
        can be set to "duo" (Shopify's admin template picker only lists
        templates from the *published* theme — see CLAUDE.md). The specific
        fragrance shown is derived from the duo product's own title (e.g.
        "Oudh Eternal Duo" becomes "Oudh Eternal"), matched against the
        perfume collection, so a duo product's title has to end with " Duo"
        exactly.
      endcomment
      if section.settings.link_to_duo_pages
        assign duo_perfume_collection = settings.free_gift_qualifying_collection
        if duo_perfume_collection == blank
          assign duo_perfume_collection = collections['signature-series']
        endif
      endif
    -%}
    {%- if carousel_products == blank or carousel_products.size == 0 -%}
      <p class="product-carousel__empty">
        {%- if section.settings.collection == blank -%}
          Select products (or a collection) to display in this section.
        {%- else -%}
          This collection has no products yet.
        {%- endif -%}
      </p>
    {%- else -%}
      {%- liquid
        assign products_count = carousel_products.size
        if products_count > section.settings.products_to_show
          assign products_count = section.settings.products_to_show
        endif
      -%}
      <product-carousel class="product-carousel" data-total="{{ products_count }}">
        {%- if products_count > 1 -%}
          <div class="product-carousel__nav-row">
            <button
              type="button"
              class="product-carousel__arrow product-carousel__arrow--prev"
              name="previous"
              aria-label="{{ 'general.slider.previous_slide' | t }}"
              aria-controls="ProductCarousel-{{ section.id }}"
              disabled
            >
              {% render 'icon-caret' %}
            </button>
            <span class="product-carousel__counter">
              <span data-carousel-current>1</span> / <span data-carousel-total>{{ products_count }}</span>
            </span>
            <button
              type="button"
              class="product-carousel__arrow product-carousel__arrow--next"
              name="next"
              aria-label="{{ 'general.slider.next_slide' | t }}"
              aria-controls="ProductCarousel-{{ section.id }}"
            >
              {% render 'icon-caret' %}
            </button>
          </div>
        {%- endif -%}

        <div class="product-carousel__viewport">
          <ul id="ProductCarousel-{{ section.id }}" class="product-carousel__list" data-carousel-track role="list">
            {%- for product in carousel_products limit: section.settings.products_to_show -%}
              {%- liquid
                assign card_url = product.url
                if section.settings.link_to_duo_pages
                  assign duo_fragrance_name = product.title | remove: ' Duo' | strip
                  assign duo_matched_perfume = blank
                  for p in duo_perfume_collection.products
                    if p.title == duo_fragrance_name
                      assign duo_matched_perfume = p
                      break
                    endif
                  endfor
                  if duo_matched_perfume != blank
                    assign card_url = product.url | append: '?view=duo&duo=' | append: duo_matched_perfume.handle
                  endif
                endif
              -%}
              <li class="product-carousel__slide" data-carousel-slide data-index="{{ forloop.index0 }}">
                <div class="product-carousel__card">
                  <div class="product-carousel__media">
                    {%- if section.settings.show_badge -%}
                      <span class="product-carousel__badge">
                        {%- if section.settings.discount_percent > 0 -%}
                          {{ section.settings.discount_percent }}% OFF
                        {%- else -%}
                          {{ section.settings.badge_text }}
                        {%- endif -%}
                      </span>
                    {%- endif -%}
                    <a href="{{ card_url }}" class="product-carousel__image-link" tabindex="-1" aria-hidden="true">
                      {%- if product.featured_media -%}
                        {{
                          product.featured_media
                          | image_url: width: 800
                          | image_tag:
                            loading: 'lazy',
                            widths: '300, 450, 600, 800',
                            sizes: '(min-width: 990px) 25vw, (min-width: 750px) 35vw, 60vw',
                            alt: product.featured_media.alt
                        }}
                      {%- else -%}
                        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                      {%- endif -%}
                    </a>
                  </div>
                  <div class="product-carousel__info">
                    <a href="{{ card_url }}" class="product-carousel__title">{{ product.title }}</a>
                    {%- if section.settings.show_description and product.description != blank -%}
                      <p class="product-carousel__desc">{{ product.description | strip_html | truncatewords: 5 }}</p>
                    {%- endif -%}
                    <div class="product-carousel__price">
                      {%- if section.settings.discount_percent > 0 -%}
                        {%- assign discount_multiplier = 100 | minus: section.settings.discount_percent -%}
                        {%- assign carousel_base_price = product.price_min -%}
                        {%- assign carousel_discount_price = carousel_base_price | times: discount_multiplier | divided_by: 100 -%}
                        <s class="product-carousel__price-was">{{ carousel_base_price | money }}</s>
                        <span class="product-carousel__price-now">{{ carousel_discount_price | money }}</span>
                        <span class="product-carousel__price-off">{{ section.settings.discount_percent }}% OFF</span>
                      {%- elsif product.price_varies -%}
                        {%- assign carousel_min_price = product.price_min | money -%}
                        {{ 'products.product.price.from_price_html' | t: price: carousel_min_price }}
                      {%- else -%}
                        {%- render 'price', product: product, price_class: 'product-carousel__price-inline', show_compare_at_price: true -%}
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              </li>
            {%- endfor -%}
          </ul>
        </div>

        {%- if products_count > 1 -%}
          <div class="product-carousel__progress-track">
            <span class="product-carousel__progress-bar" data-carousel-progress></span>
          </div>
        {%- endif -%}
      </product-carousel>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    if (customElements.get('product-carousel')) return;

    class ProductCarousel extends HTMLElement {
      constructor() {
        super();
        this.track = this.querySelector('[data-carousel-track]');
        this.slides = Array.from(this.querySelectorAll('[data-carousel-slide]'));
        this.prevButton = this.querySelector('button[name="previous"]');
        this.nextButton = this.querySelector('button[name="next"]');
        this.currentEl = this.querySelector('[data-carousel-current]');
        this.progressBar = this.querySelector('[data-carousel-progress]');

        if (!this.track || !this.slides.length) return;

        this.observeReveal();

        if (this.prevButton && this.nextButton) {
          this.prevButton.addEventListener('click', () => this.step(-1));
          this.nextButton.addEventListener('click', () => this.step(1));
          this.track.addEventListener('scroll', () => this.update(), { passive: true });
          window.addEventListener('resize', () => this.update());
          this.update();
        }
      }

      observeReveal() {
        var header = this.closest('.product-carousel-wrapper').querySelector('[data-carousel-header]');
        var revealTargets = header ? [header].concat(this.slides) : this.slides;

        if (
          !('IntersectionObserver' in window) ||
          window.matchMedia('(prefers-reduced-motion: reduce)').matches
        ) {
          revealTargets.forEach(function (el) {
            el.classList.add(el === header ? 'product-carousel__title-row--visible' : 'product-carousel__slide--visible');
          });
          return;
        }

        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              var el = entry.target;
              if (el === header) {
                el.classList.add('product-carousel__title-row--visible');
              } else {
                var index = parseInt(el.dataset.index, 10) || 0;
                el.style.transitionDelay = (index % 4) * 80 + 'ms';
                el.classList.add('product-carousel__slide--visible');
              }
              observer.unobserve(el);
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -60px 0px' }
        );

        revealTargets.forEach(function (el) {
          observer.observe(el);
        });
      }

      step(direction) {
        var slideWidth = this.slides[0].getBoundingClientRect().width;
        var gap = parseFloat(getComputedStyle(this.track).columnGap || getComputedStyle(this.track).gap || 0);
        this.track.scrollBy({ left: direction * (slideWidth + gap), behavior: 'smooth' });
      }

      update() {
        var scrollLeft = this.track.scrollLeft;
        var maxScroll = this.track.scrollWidth - this.track.clientWidth;

        if (this.prevButton) this.prevButton.disabled = scrollLeft <= 2;
        if (this.nextButton) this.nextButton.disabled = scrollLeft >= maxScroll - 2;

        if (this.progressBar) {
          var progress = maxScroll > 0 ? (scrollLeft / maxScroll) * 100 : 100;
          var minWidth = (this.track.clientWidth / this.track.scrollWidth) * 100;
          this.progressBar.style.width = Math.max(minWidth, 12) + '%';
          this.progressBar.style.left = (progress * (100 - Math.max(minWidth, 12))) / 100 + '%';
        }

        if (this.currentEl) {
          var slideWidth = this.slides[0].getBoundingClientRect().width;
          var gap = parseFloat(getComputedStyle(this.track).columnGap || getComputedStyle(this.track).gap || 0);
          var index = Math.round(scrollLeft / (slideWidth + gap));
          this.currentEl.textContent = Math.min(index + 1, this.slides.length);
        }
      }
    }

    customElements.define('product-carousel', ProductCarousel);
  })();
</script>

{% schema %}
{
  "name": "Product Carousel",
  "tag": "section",
  "class": "section section-product-carousel",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "default": true,
      "label": "Make section full width"
    },
    {
      "type": "text",
      "id": "title",
      "default": "Duo & Trio",
      "label": "Heading"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products",
      "limit": 20,
      "info": "Hand-pick exactly which products appear here, in this order. Takes priority over the collection below."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "…or a collection",
      "info": "Used only when no products are hand-picked above."
    },
    {
      "type": "checkbox",
      "id": "link_to_duo_pages",
      "label": "Link cards to their duo page",
      "default": false,
      "info": "For the Duo carousel only: each card's product must be a real product titled \"<fragrance> Duo\" (e.g. \"Oudh Eternal Duo\") existing only to host that fragrance's duo page. This forces the link open correctly regardless of that product's own Theme template."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 20,
      "step": 1,
      "default": 8,
      "label": "Products to show"
    },
    {
      "type": "range",
      "id": "discount_percent",
      "min": 0,
      "max": 70,
      "step": 1,
      "unit": "%",
      "default": 0,
      "label": "Discount to show on cards",
      "info": "Shows \"X% OFF\" and the discounted price on every card. Set to 0 to show the regular prices instead."
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "default": true,
      "label": "Show badge"
    },
    {
      "type": "text",
      "id": "badge_text",
      "default": "Online Exclusive",
      "label": "Badge text"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "default": true,
      "label": "Show product description"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Product Carousel"
    }
  ]
}
{% endschema %}
