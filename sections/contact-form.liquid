{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="contact page-width section-{{ section.id }}-padding">
    {%- liquid
      assign has_info = false
      if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.description != blank
        assign has_info = true
      elsif section.settings.contact_phone != blank or section.settings.contact_email != blank or section.settings.contact_hours != blank
        assign has_info = true
      endif
    -%}
    <div class="contact__wrap{% unless has_info %} contact__wrap--form-only{% endunless %}">
      {%- if has_info -%}
      <div class="contact__info{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="contact__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="contact__heading {{ section.settings.heading_size }}">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="contact__description rte">
            {{ section.settings.description }}
          </div>
        {%- endif -%}

        {%- comment -%}
          Plain label/value rows split by hairlines — no icon badges or tracked
          capitals, which read as template decoration.
        {%- endcomment -%}
        {%- if section.settings.contact_phone != blank
          or section.settings.contact_email != blank
          or section.settings.contact_hours != blank
        -%}
          <dl class="contact__details">
            {%- if section.settings.contact_email != blank -%}
              <div class="contact__detail">
                <dt>Email</dt>
                <dd>
                  {%- comment -%}
                    "@" and "." as HTML entities: the browser shows and links
                    the address exactly as before, but email-harvesting bots
                    (and SEO checkers that flag plain-text addresses) don't
                    match it.
                  {%- endcomment -%}
                  {%- assign contact_email_safe = section.settings.contact_email | escape | replace: '@', '&#64;' | replace: '.', '&#46;' -%}
                  <a href="mailto:{{ contact_email_safe }}">{{ contact_email_safe }}</a>
                </dd>
              </div>
            {%- endif -%}
            {%- if section.settings.contact_phone != blank -%}
              <div class="contact__detail">
                <dt>Phone</dt>
                <dd>
                  <a href="tel:{{ section.settings.contact_phone | remove: ' ' }}">{{ section.settings.contact_phone }}</a>
                </dd>
              </div>
            {%- endif -%}
            {%- if section.settings.contact_hours != blank -%}
              <div class="contact__detail">
                <dt>Hours</dt>
                <dd>{{ section.settings.contact_hours }}</dd>
              </div>
            {%- endif -%}
          </dl>
        {%- endif -%}
      </div>
      {%- endif -%}

      <div class="contact__panel{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {%- form 'contact', id: 'ContactForm', class: 'contact__form isolate' -%}
          {%- if form.posted_successfully? -%}
            <div class="contact__status contact__status--success">
              {% render 'icon-success' %}
              <span>{{ 'templates.contact.form.post_success' | t }}</span>
            </div>
          {%- elsif form.errors -%}
            <div class="contact__status contact__status--error" role="alert" tabindex="-1" autofocus>
              {% render 'icon-error' %}
              <span>
                {{ 'templates.contact.form.error_heading' | t }}
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
              </span>
            </div>
          {%- endif -%}

          {%- comment -%}
            Static labels above underline inputs rather than Dawn's floating
            .field labels — deliberately not using .field / .field__input so
            base.css's boxed border (.field::after) never applies here.
          {%- endcomment -%}
          <div class="contact__row">
            <div class="contact__field">
              <label class="contact__label" for="ContactForm-name">{{ 'templates.contact.form.name' | t }}</label>
              <input
                class="contact__input"
                autocomplete="name"
                type="text"
                id="ContactForm-name"
                name="contact[{{ 'templates.contact.form.name' | t }}]"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
              >
            </div>
            <div class="contact__field">
              <label class="contact__label" for="ContactForm-email">
                {{- 'templates.contact.form.email' | t -}}
                <span class="contact__required" aria-hidden="true">*</span>
              </label>
              <input
                class="contact__input"
                autocomplete="email"
                type="email"
                id="ContactForm-email"
                name="contact[email]"
                spellcheck="false"
                autocapitalize="off"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                required
                aria-required="true"
                {% if form.errors contains 'email' %}
                  aria-invalid="true"
                  aria-describedby="ContactForm-email-error"
                {% endif %}
              >
              {%- if form.errors contains 'email' -%}
                <small class="contact__field-error" id="ContactForm-email-error">
                  <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
                  {%- render 'icon-error' -%}
                  {{- form.errors.translated_fields.email | capitalize }}
                  {{ form.errors.messages.email -}}
                </small>
              {%- endif -%}
            </div>
          </div>

          <div class="contact__field">
            <label class="contact__label" for="ContactForm-phone">
              {{- 'templates.contact.form.phone' | t -}}
              <span class="contact__optional">(optional)</span>
            </label>
            <input
              class="contact__input"
              type="tel"
              id="ContactForm-phone"
              autocomplete="tel"
              name="contact[{{ 'templates.contact.form.phone' | t }}]"
              value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
            >
          </div>

          <div class="contact__field">
            <label class="contact__label" for="ContactForm-body">{{ 'templates.contact.form.comment' | t }}</label>
            <textarea
              class="contact__input contact__input--area"
              rows="3"
              id="ContactForm-body"
              name="contact[{{ 'templates.contact.form.comment' | t }}]"
            >
              {{- form.body -}}
            </textarea>
          </div>

          <div class="contact__actions">
            <button type="submit" class="button contact__submit">
              {{ 'templates.contact.form.send' | t }}
            </button>
            <p class="contact__note">{{ 'templates.contact.form.response_note' | t }}</p>
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.contact-form.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Intro"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "default": "Contact us",
      "label": "Eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Get in touch",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "Contact details"
    },
    {
      "type": "text",
      "id": "contact_phone",
      "label": "Phone number"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Email address"
    },
    {
      "type": "text",
      "id": "contact_hours",
      "label": "Working hours"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "t:sections.contact-form.presets.name"
    }
  ]
}
{% endschema %}