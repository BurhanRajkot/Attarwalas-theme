{{ 'section-offer-builder.css' | asset_url | stylesheet_tag }}
<script src="{{ 'offer-builder.js' | asset_url }}" defer="defer"></script>

{%- liquid
  comment
    Config resolution order for every value: product metafield (namespace `offer`)
    first, then the section setting as a fallback. Metafields let one shared
    `product.offer` template drive many offer products; section settings let a
    duplicated template be configured entirely in the theme editor.

    config_mode gates whether metafields are consulted at all: "editor" (used by
    the per-offer templates) ignores metafields completely so the theme editor is
    exactly what the customer sees, regardless of what's left over on the
    product's metafields. "auto" (the shared product.offer template) reads them
    normally. Assigning `mf` to blank here is enough — every value below already
    falls back to the section setting when `mf.xxx.value` is blank.
  endcomment

  assign is_editor_mode = false
  if section.settings.config_mode == 'editor'
    assign is_editor_mode = true
  endif

  if is_editor_mode
    assign mf = blank
  else
    assign mf = product.metafields.offer
  endif

  assign tagline = mf.tagline.value | default: section.settings.tagline
  assign perks_raw = mf.perks.value | default: section.settings.perks
  assign button_label = mf.button_label.value | default: section.settings.button_label
  assign banner_image = mf.banner.value | default: section.settings.banner_image

  assign badge_text = mf.badge.value | default: section.settings.badge

  comment
    Discount pricing: instead of a fixed bundle price, the offer can apply a
    discount to the retail total of whatever the customer actually picks. The
    cart price is then computed live (retail minus discount) and travels on the
    lines as `_bundle_price` — the discount function applies it as usual.
  endcomment
  assign discount_type = mf.discount_type.value | default: section.settings.discount_type | downcase
  assign discount_amount = mf.discount_amount.value | default: section.settings.discount_amount | plus: 0

  # whole-number discounts read as "18% off", not "18.0% off"
  assign discount_amount_display = discount_amount
  assign discount_amount_rounded = discount_amount | round
  if discount_amount_rounded == discount_amount
    assign discount_amount_display = discount_amount_rounded
  endif

  assign use_discount = false
  if discount_type != 'none' and discount_type != blank and discount_amount > 0
    assign use_discount = true
  endif

  comment
    Groups: a metafield-defined single group wins over editor blocks, so an offer
    product can override a shared template without touching the customizer. The
    `offer.collection` metafield may be a comma-separated list of collection
    handles ("men, women, unisex") to merge several collections into one picker.
  endcomment
  assign mf_collection_handle = mf.collection.value | strip
  assign mf_pick_count = mf.pick_count.value | plus: 0

  assign group_blocks = section.blocks | where: 'type', 'group'

  comment
    A Pick group block counts as "configured" once it has hand-picked products
    or a collection on it. Configured blocks WIN over the offer.collection
    metafield — that's what lets one offer be curated by hand in the editor
    while the others still run off the shared metafield config. Blocks that are
    left empty change nothing, so adding a template doesn't break an offer.
  endcomment
  assign blocks_configured = false
  for block in group_blocks
    if block.settings.products != blank and block.settings.products.size > 0
      assign blocks_configured = true
    elsif block.settings.collections != blank and block.settings.collections.size > 0
      assign blocks_configured = true
    elsif block.settings.collection != blank
      assign blocks_configured = true
    endif
  endfor

  assign use_metafield_group = false
  if mf_collection_handle != blank and mf_pick_count > 0 and blocks_configured == false
    assign use_metafield_group = true
  endif

  comment
    Choice mode turns the Pick group blocks into mutually exclusive tabs —
    "Perfumes" or "Attar Roll-Ons" — instead of stacking them down the page.
    One tab is on screen at a time and only that tab's picks make up the
    bundle, so a customer can't end up half perfumes, half attars. Needs two
    or more blocks to mean anything, and never applies to the metafield's
    single group.
  endcomment
  assign is_choice_mode = false
  if section.settings.group_mode == 'choice' and use_metafield_group == false and group_blocks.size > 1
    assign is_choice_mode = true
  endif

  comment
    Total items the customer has to pick across every group. A quantity-mode
    group (the duo page) has no fixed count, so it contributes its minimum —
    the smallest bundle the customer can check out with.
  endcomment
  assign total_pick_count = 0
  assign has_range_group = false
  if use_metafield_group
    assign total_pick_count = mf_pick_count
  elsif is_choice_mode
    comment
      In choice mode the bundle is one tab's worth, never the sum of every
      tab's, so only the tab that's open on load counts here. offer-builder.js
      re-reads the count from whichever tab the customer switches to.
    endcomment
    assign first_block = group_blocks | first
    if first_block.settings.pick_mode == 'range'
      assign has_range_group = true
      assign total_pick_count = first_block.settings.min_pick | plus: 0
    else
      assign total_pick_count = first_block.settings.pick_count | plus: 0
    endif
  else
    for block in group_blocks
      if block.settings.pick_mode == 'range'
        assign has_range_group = true
        assign block_count = block.settings.min_pick | plus: 0
      else
        assign block_count = block.settings.pick_count | plus: 0
      endif
      assign total_pick_count = total_pick_count | plus: block_count
    endfor
  endif

  if badge_text == blank and total_pick_count > 0
    if use_discount
      if discount_type == 'fixed'
        assign discount_money = discount_amount | times: 100 | money_without_trailing_zeros | replace: 'Rs.', '₹' | replace: '₹ ', '₹'
        assign discount_display = 'Flat ' | append: discount_money | append: ' off'
      else
        assign discount_display = discount_amount_display | append: '% off'
      endif
      comment
        A quantity-mode offer has no "any N" to advertise — the customer sets
        the quantities — so the badge is just the discount.
      endcomment
      if has_range_group
        assign badge_text = discount_display
      else
        assign badge_text = 'Get any ' | append: total_pick_count | append: ' — ' | append: discount_display
      endif
    elsif product.price > 0
      assign formatted_price = product.price | money_without_trailing_zeros | replace: 'Rs.', '₹' | replace: '₹ ', '₹'
      assign badge_text = 'Get any ' | append: total_pick_count | append: ' for ' | append: formatted_price
    else
      assign badge_text = 'Get any ' | append: total_pick_count
    endif
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if total_pick_count == 0 -%}
  {%- if request.design_mode -%}
    <div class="page-width">
      <div class="offer-builder__setup-hint">
        <p>
          <strong>This offer has no picker groups yet.</strong>
          Use <em>Add block &rarr; Pick group</em> in the sidebar to add one
          (choose the eligible collection and how many items the customer picks),
          or set the <code>offer.collection</code> and <code>offer.pick_count</code>
          metafields on this product.
        </p>
      </div>
    </div>
  {%- endif -%}
{%- else -%}

<offer-builder
  id="OfferBuilder-{{ section.id }}"
  class="offer-builder color-{{ section.settings.color_scheme }}"
  data-offer-id="{{ product.id }}"
  data-offer-handle="{{ product.handle }}"
  data-offer-title="{{ product.title | escape }}"
  data-offer-price="{{ product.price }}"
  data-offer-price-formatted="{{ product.price | money }}"
  data-total-pick-count="{{ total_pick_count }}"
  data-money-format="{{ shop.money_format | strip_html | escape }}"
  data-ready-label="{{ button_label | escape }}"
  {% if is_choice_mode %}data-group-mode="choice"{% endif %}
  {% if use_discount %}
    data-discount-type="{{ discount_type }}"
    data-discount-amount="{{ discount_amount }}"
  {% endif %}
>
  {%- if banner_image != blank -%}
    <div class="offer-builder__banner-media{% if section.settings.banner_full_width %} offer-builder__banner-media--full{% endif %}">
      {{
        banner_image
        | image_url: width: 2200
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '600, 900, 1200, 1600, 2200',
          sizes: '100vw',
          alt: product.title | escape
      }}
    </div>
  {%- endif -%}

  <div class="page-width section-{{ section.id }}-padding">
    <header class="offer-builder__intro">
      {%- if badge_text != blank -%}
        <div class="offer-builder__badge">
          {% render 'icon-discount' %}
          <span>{{ badge_text }}</span>
        </div>
      {%- endif -%}

      <h1 class="offer-builder__title">{{ product.title | escape }}</h1>

      {%- if tagline != blank -%}
        <p class="offer-builder__tagline">{{ tagline }}</p>
      {%- endif -%}

      {%- if use_discount or product.price > 0 or product.compare_at_price > product.price -%}
      <div class="offer-builder__price">
        {%- if use_discount -%}
          <span class="offer-builder__price-discount">
            {%- if discount_type == 'fixed' -%}
              Flat {{ discount_amount | times: 100 | money_without_trailing_zeros | replace: 'Rs.', '₹' | replace: '₹ ', '₹' }} OFF
            {%- else -%}
              {{ discount_amount_display }}% OFF
            {%- endif -%}
          </span>
          <span class="offer-builder__price-note">
            {%- if section.settings.price_note != blank -%}
              {{ section.settings.price_note }}
            {%- elsif has_range_group -%}
              on whatever you pick below
            {%- elsif is_choice_mode -%}
              {%- comment -%}
                Choice mode's tabs aren't necessarily all perfumes — offer-2/3/5
                each carry an attar roll-on tab — so the auto note stays neutral.
              {%- endcomment -%}
              on any {{ total_pick_count }} items
            {%- else -%}
              on any {{ total_pick_count }} perfumes
            {%- endif -%}
          </span>
        {%- elsif product.price > 0 -%}
          {%- comment -%}
            A zero price means the offer product has no price set in admin —
            better to show nothing than "₹0" as the bundle price.
          {%- endcomment -%}
          <span class="offer-builder__price-label">Bundle price</span>
          <span class="offer-builder__price-now">
            {{- product.price | money_without_trailing_zeros | replace: 'Rs.', '₹' | replace: '₹ ', '₹' -}}
          </span>
          {%- if product.compare_at_price > product.price -%}
            <s class="offer-builder__price-was">
              {{- product.compare_at_price | money_without_trailing_zeros | replace: 'Rs.', '₹' | replace: '₹ ', '₹' -}}
            </s>
            <span class="offer-builder__price-save">
              Save {{ product.compare_at_price | minus: product.price | money_without_trailing_zeros | replace: 'Rs.', '₹' | replace: '₹ ', '₹' }}
            </span>
          {%- endif -%}
        {%- endif -%}
      </div>
      {%- endif -%}

      {%- liquid
        if perks_raw != blank
          assign perks = perks_raw | strip | newline_to_br | replace: '<br />', '||' | strip_html | split: '||'
        endif
      -%}
      {%- if perks != blank and perks.size > 0 -%}
        <ul class="offer-builder__perks">
          {%- for perk in perks -%}
            {%- if perk != blank -%}
              <li>
                {% render 'icon-checkmark' %}
                <span>{{ perk | strip }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </header>

    {%- if section.settings.show_steps -%}
      <ol class="offer-builder__steps" role="list">
        <li class="offer-builder__step">
          <span class="offer-builder__step-num">01</span>
          <span class="offer-builder__step-text">
            {%- if section.settings.steps_first_line != blank -%}
              {{ section.settings.steps_first_line }}
            {%- else -%}
              Pick any {{ total_pick_count }} fragrance{% if total_pick_count > 1 %}s{% endif %} below
            {%- endif -%}
          </span>
        </li>
        <li class="offer-builder__step">
          <span class="offer-builder__step-num">02</span>
          <span class="offer-builder__step-text">Add the bundle to your cart</span>
        </li>
        <li class="offer-builder__step">
          <span class="offer-builder__step-num">03</span>
          <span class="offer-builder__step-text">The offer price is applied automatically</span>
        </li>
      </ol>
    {%- endif -%}

    {%- if is_choice_mode -%}
      {%- comment -%}
        One button per Pick group block. The panels themselves are the groups
        rendered below; offer-builder.js swaps which one is visible and clears
        the picks made on the tab being left.
      {%- endcomment -%}
      <div class="offer-choice" role="tablist" aria-label="{{ section.settings.choice_label | default: 'Choose what to bundle' | escape }}">
        {%- for block in group_blocks -%}
          {%- liquid
            assign tab_label = block.settings.tab_label | default: block.settings.heading
            if tab_label == blank
              assign tab_label = 'Option ' | append: forloop.index
            endif
          -%}
          <button
            type="button"
            class="offer-choice__tab{% if forloop.first %} offer-choice__tab--active{% endif %}"
            id="OfferChoiceTab-{{ section.id }}-{{ forloop.index0 }}"
            data-offer-choice-tab
            data-group-index="{{ forloop.index0 }}"
            role="tab"
            aria-controls="OfferGroup-{{ section.id }}-{{ forloop.index0 }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          >
            {%- if block.settings.tab_image != blank -%}
              <span class="offer-choice__tab-media">
                {{
                  block.settings.tab_image
                  | image_url: width: 160
                  | image_tag: loading: 'lazy', widths: '80, 120, 160', sizes: '4rem', alt: ''
                }}
              </span>
            {%- endif -%}
            <span class="offer-choice__tab-label">{{ tab_label }}</span>
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="offer-builder__groups">
      {%- if use_metafield_group -%}
        {%- render 'offer-group',
          group_index: 0,
          group_heading: mf.group_heading.value,
          group_collections: mf_collection_handle,
          group_pick_count: mf_pick_count,
          group_open: true,
          offer_product: product,
          add_label: section.settings.add_label,
          soldout_label: section.settings.soldout_label
        -%}
      {%- else -%}
        {%- for block in group_blocks -%}
          {%- liquid
            assign block_collections_str = blank
            if block.settings.collections != blank and block.settings.collections.size > 0
              assign block_collection_handles = block.settings.collections | map: 'handle'
              assign block_collections_str = block_collection_handles | join: ','
            endif

            # Exact mode passes min = max = pick_count, so offer-group behaves
            # exactly as it did before quantity mode existed.
            if block.settings.pick_mode == 'range'
              assign block_min = block.settings.min_pick | plus: 0
              assign block_max = block.settings.max_pick | plus: 0
            else
              assign block_min = block.settings.pick_count | plus: 0
              assign block_max = block_min
            endif

            # Choice mode: every tab but the first renders hidden, and each
            # group becomes its tab's panel. Blank outside choice mode, which
            # leaves the group markup exactly as it was.
            assign group_dom_id = blank
            assign group_tab_id = blank
            assign group_hidden = false
            if is_choice_mode
              assign group_dom_id = 'OfferGroup-' | append: section.id | append: '-' | append: forloop.index0
              assign group_tab_id = 'OfferChoiceTab-' | append: section.id | append: '-' | append: forloop.index0
              unless forloop.first
                assign group_hidden = true
              endunless
            endif
          -%}
          {%- render 'offer-group',
            group_index: forloop.index0,
            group_heading: block.settings.heading,
            group_products: block.settings.products,
            group_collections: block_collections_str,
            group_collection: block.settings.collection,
            group_pick_count: block.settings.pick_count,
            group_min: block_min,
            group_max: block_max,
            group_include: block.settings.include,
            group_noun: block.settings.noun,
            group_open: block.settings.open_by_default,
            group_id: group_dom_id,
            group_labelled_by: group_tab_id,
            group_hidden: group_hidden,
            offer_product: product,
            add_label: section.settings.add_label,
            soldout_label: section.settings.soldout_label,
            block_attributes: block.shopify_attributes
          -%}
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- liquid
      # Sibling offers from the "offer" collection — lets the customer hop
      # between "Offer for 2 / 3 / 5" without going back to the product page.
      # A duo page points this at the "duo" collection instead, so duos link
      # to other duos rather than to the bundle offers.
      assign more_offers_handle = section.settings.more_offers_collection | default: 'offer'
      assign more_offers = collections[more_offers_handle].products
      # filters aren't allowed on `render` arguments, so build the id up here
      assign more_offers_strip_id = section.id | append: '-more'
    -%}
    {%- if more_offers != blank and more_offers.size > 0 -%}
      <div class="offer-builder__more">
        {%- render 'offer-strip',
          offer_products: more_offers,
          strip_heading: section.settings.more_offers_heading,
          strip_id: more_offers_strip_id,
          exclude_offer_id: product.id,
          pill_label: section.settings.card_pill_label,
          cta_label: section.settings.card_cta_label
        -%}
      </div>
    {%- endif -%}
  </div>

  <div class="offer-builder__bar" data-offer-bar>
    <div class="offer-builder__bar-track" aria-hidden="true">
      <span class="offer-builder__bar-fill"></span>
    </div>

    <div class="offer-builder__bar-inner page-width">
      <div class="offer-builder__bar-summary">
        <div class="offer-builder__bar-progress">
          <span class="offer-builder__bar-count" data-offer-counter>
            {%- comment -%}
              Quantity mode has no fixed total to count towards, so the bar
              shows a running count. Matches what offer-builder.js writes on
              its first render, so the number never flickers.
            {%- endcomment -%}
            {%- if has_range_group -%}0{%- else -%}0 / {{ total_pick_count }}{%- endif -%}
          </span>
          <span class="offer-builder__bar-label">{{ section.settings.selected_label }}</span>
        </div>

        {%- comment -%}
          The bundle tray. offer-builder.js fills this with one slot per pick
          the offer asks for: empty slots show a dashed outline, filled slots
          show the product thumbnail and remove themselves when clicked.

          Rendered empty here and built in JS because the slot count follows
          the *active* group in choice mode (Perfumes vs Attar Roll-Ons have
          their own pick counts), so it isn't known at Liquid time.

          Without JS this stays an empty list and the text summary below still
          describes the bundle, so nothing is lost.
        {%- endcomment -%}
        <ol class="offer-tray" data-offer-tray role="list" aria-label="Items in your bundle"></ol>

        <p class="offer-builder__bar-picks" data-offer-picks></p>
      </div>

      <div class="offer-builder__bar-cta">
        <div class="offer-builder__bar-pricing">
          <span class="offer-builder__bar-price" data-offer-bar-price>
            {{- product.price | money_without_trailing_zeros | replace: 'Rs.', '₹' | replace: '₹ ', '₹' -}}
          </span>
          <span class="offer-builder__bar-worth" data-offer-worth hidden></span>
        </div>
        <button type="button" class="offer-builder__bar-add" data-offer-add disabled>
          <span data-offer-add-label>{{ button_label }}</span>
          {% render 'loading-spinner' %}
        </button>
      </div>
    </div>
    <p class="offer-builder__bar-error" data-offer-error hidden role="alert"></p>
  </div>
</offer-builder>

{%- endif -%}

{% schema %}
{
  "name": "Offer Builder",
  "tag": "section",
  "class": "section section--offer-builder",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "The offer product's own price is the bundle price (or set a Discount below to price it off the retail total instead). Add one \"Pick group\" block per set the customer picks from — each block takes hand-picked products, one or more collections, or a single collection."
    },
    {
      "type": "select",
      "id": "config_mode",
      "options": [
        { "value": "auto", "label": "Auto — metafield fills in blanks (shared template)" },
        { "value": "editor", "label": "Only this template — ignore metafields entirely" }
      ],
      "default": "auto",
      "label": "Offer settings come from",
      "info": "\"Auto\" lets the offer.* product metafields drive this page wherever a Pick group block is left blank — use this on the shared product.offer template. \"Only this template\" ignores metafields completely, so everything below and the Pick group blocks are the only source — use this on a per-offer template (product.offer-2, -3, -5, etc.)."
    },
    {
      "type": "select",
      "id": "group_mode",
      "options": [
        { "value": "stack", "label": "Stacked — the customer picks from every group" },
        { "value": "choice", "label": "Tabs — the customer picks one group, then fills it" }
      ],
      "default": "stack",
      "label": "Pick groups are",
      "info": "\"Stacked\" is the classic offer (and the duo page): every Pick group has to be filled. \"Tabs\" shows one group at a time behind a row of buttons — \"Perfumes\" / \"Attar Roll-Ons\" — and the bundle is made up of that one group only; switching tabs clears what was picked on the other. Needs two or more Pick group blocks."
    },
    {
      "type": "text",
      "id": "choice_label",
      "label": "Tabs — accessible label",
      "info": "Read out by screen readers before the tab buttons. Blank uses \"Choose what to bundle\"."
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner image",
      "info": "Wide promo image shown above the title. Overridden by the offer.banner metafield."
    },
    {
      "type": "checkbox",
      "id": "banner_full_width",
      "label": "Banner spans full window width",
      "default": false
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge text",
      "info": "Leave blank to auto-generate from the pick count and price."
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Mix and match your favourites and pay one bundle price."
    },
    {
      "type": "textarea",
      "id": "perks",
      "label": "Perks (one per line)",
      "default": "Free shipping on this offer\nMix any sizes you like"
    },
    {
      "type": "checkbox",
      "id": "show_steps",
      "label": "Show the \"how it works\" steps",
      "default": true,
      "info": "The 01 / 02 / 03 strip between the header and the picker."
    },
    {
      "type": "text",
      "id": "steps_first_line",
      "label": "Step 01 text",
      "info": "Leave blank to auto-generate (\"Pick any 3 fragrances below\"). Set it on a duo, where there's no single pick count to name — e.g. \"Pick your perfume and your attar below\"."
    },
    {
      "type": "text",
      "id": "price_note",
      "label": "Discount note",
      "info": "The small line under the discount in the page header. Leave blank to auto-generate."
    },
    {
      "type": "header",
      "content": "Discount"
    },
    {
      "type": "select",
      "id": "discount_type",
      "options": [
        { "value": "none", "label": "No discount — use the product's fixed price" },
        { "value": "fixed", "label": "Fixed amount off (₹)" },
        { "value": "percent", "label": "Percentage off (%)" }
      ],
      "default": "none",
      "label": "Discount type"
    },
    {
      "type": "number",
      "id": "discount_amount",
      "label": "Discount amount",
      "default": 0,
      "info": "In ₹ for \"Fixed amount off\", in % for \"Percentage off\". The customer's cart price = retail total of the picked perfumes minus this discount, computed live. Overridden by the offer.discount_type / offer.discount_amount metafields."
    },
    {
      "type": "header",
      "content": "Labels"
    },
    {
