        },
        {
          "type": "collection_list",
          "id": "collections",
          "label": "…or eligible collections",
          "limit": 10,
          "info": "Select one or more collections to merge into one picker (products deduped across them). Used only when no products are hand-picked above; takes priority over the single collection below."
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "…or a single collection",
          "info": "Used only when nothing is set above."
        },
